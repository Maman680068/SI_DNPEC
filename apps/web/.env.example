# Valeurs de développement local ci-dessous. En production (déploiement Render),
# ces deux variables pointent sur l'URL de l'API déployée — voir render.yaml
# (service dnpec-web) et docs/deploiement-render.md.

# URL de l'API NestJS, utilisée côté serveur par les Route Handlers (app/api/auth/*).
API_BASE_URL=http://localhost:3000

# URL de l'API NestJS, utilisée directement par le navigateur (tasks, 2FA setup, etc.).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
