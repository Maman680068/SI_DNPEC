DATABASE_URL="postgresql://user:password@localhost:5432/dnpec_dev?schema=public"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
PORT=3000

# Optionnel — sans SMTP_HOST, les emails sont journalisés mais jamais
# réellement envoyés (voir communication/notifications/email.service.ts).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@dnpec.gov.gn"

# Optionnel — racine de stockage disque local des documents GED (défaut :
# <projet>/storage/documents). ATTENTION : disque éphémère sur un Web Service
# Render standard — voir common/storage/storage.service.ts avant la mise en
# production (Render Persistent Disk pointé ici, ou bascule vers MinIO/S3).
DOCUMENTS_STORAGE_PATH=""
