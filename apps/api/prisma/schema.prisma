// ============================================================================
// SI DNPEC — Schéma de base de données (Prisma)
// ============================================================================
// Portée de cette version : Utilisateurs & rôles, Organisation (Divisions/
// Sections), Tâches (RF-TAC-*), Communication (RF-COM-*), Archivage/GED
// (RF-GED-*), Congés (RF-CNG-*), Notifications, Journal d'audit (RF-SEC-04).
//
// Non modélisé à ce stade (hors périmètre de cette demande, à traiter
// séparément si besoin) : Annuaire (dérivable de User/Division/Section,
// RF-CPL-02).
//
// Décisions de conception à noter :
// 1. Chargé d'Études vs Agent : ce n'est plus un rôle système distinct — le
//    rôle reste AGENT dans les deux cas (même permission). "Chargé d'Études"
//    (personnel des Divisions) et l'intitulé de poste du personnel des
//    cellules transversales (RH, SAF, CTSCM, CNC, CSID) ne sont qu'un
//    intitulé d'affichage, porté par User.jobTitle (libre, optionnel).
//    Un Agent rattaché à une Division (divisionId non nul) est ainsi
//    affiché "Chargé d'Études" par convention métier ; un Agent d'une
//    cellule a divisionId = null, celluleId non nul, et jobTitle libre.
// 2. Assistant de direction (ASSISTANT_DIRECTION) : rattaché à la personne
//    qu'il assiste via supervisorId (auto-relation sur User), plutôt qu'à
//    une Division ou une Cellule. Le superviseur doit avoir le rôle DN, DNA
//    ou CHEF_CELLULE (invariant applicatif, voir décision n°4) — un Chef de
//    Division est délibérément exclu, l'Assistant restant réservé à la
//    direction générale et aux cellules transversales. Visibilité en
//    cascade (CascadeService) : l'Assistant voit ce que voit son
//    superviseur (tâches, périmètre utilisateurs), mais ni le niveau de
//    confidentialité qu'il peut consulter/créer, ni son autorité d'action
//    (gestion de comptes, diffusion à une division, etc.) ne sont étendus —
//    ceux-ci restent ceux du rôle ASSISTANT_DIRECTION lui-même.
// 3. Cellules transversales (CTSCM, CNC, SAF, RH, CSID) : modélisées par un
//    modèle Cellule minimal (id, code, name, chefId), distinct de
//    Division/Section (pas de sous-structure en sections). Un utilisateur
//    est rattaché à une Division OU à une Cellule, jamais les deux (voir
//    invariant ci-dessous) ; il en va de même pour Task.divisionId/
//    Task.celluleId, afin que CHEF_CELLULE ait une visibilité en cascade
//    sur les tâches de sa cellule symétrique à celle de CHEF_DIVISION
//    (module tasks/). Les 5 cellules sont fournies en données de seed
//    (prisma/seed.ts), à exécuter après la première migration.
//    - SAF, RH, CSID ont un chef de cellule (rôle CHEF_CELLULE, pointé par
//      Cellule.chefId) qui gère ses propres Chargés d'Études (rôle AGENT,
//      celluleId = sa cellule) exactement comme un Chef de Division gère
//      les siens : assignation de tâches et validation des congés en
//      cascade sur son périmètre (celluleId). Cette cascade est une règle
//      applicative (guards NestJS), symétrique à celle de CHEF_DIVISION —
//      aucune structure de données supplémentaire n'est nécessaire.
//    - CTSCM et CNC existent comme lignes Cellule (seed) mais leur
//      structure interne (chef de cellule ou non, effectif) n'est pas
//      connue à ce stade (§11) : Cellule.chefId reste null pour elles tant
//      que l'information n'est pas fournie ; ne rien supposer de plus.
// 4. Invariants non exprimables nativement en Prisma (à valider en base ou en
//    application) : User.sectionId doit appartenir à User.divisionId ;
//    User.divisionId et User.celluleId sont mutuellement exclusifs (jamais
//    les deux renseignés en même temps), de même pour Task.divisionId /
//    Task.celluleId ; Task.sectionId doit appartenir à Task.divisionId ;
//    User.supervisorId ne doit référencer qu'un User de rôle DN, DNA ou
//    CHEF_CELLULE ; un CHEF_CELLULE doit avoir celluleId = l'id de la
//    Cellule dont il est le chefId.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Énumérations
// ----------------------------------------------------------------------------

enum SystemRole {
  DN // Directeur National
  DNA // Directeur National Adjoint — même autorité que le DN (§2.1)
  CHEF_DIVISION
  CHEF_SECTION
  // Chef d'une cellule transversale (SAF, RH, CSID pour l'instant — voir
  // Cellule.chefId). Même logique de cascade que CHEF_DIVISION, à l'échelle
  // de sa celluleId : assignation de tâches et validation des congés de ses
  // Chargés d'Études.
  CHEF_CELLULE
  // Personnel de base, qu'il soit rattaché à une Division (affiché "Chargé
  // d'Études" via jobTitle) ou à une cellule transversale (jobTitle libre) —
  // même niveau de permission dans les deux cas.
  AGENT
  ADMIN_SYSTEME // CSID — gestion des comptes et de l'infrastructure
  // Assistant(e) de direction, rattaché à un DN/DNA ou un Chef de Cellule
  // (rôle du superviseur porté par User.supervisorId, jamais un Chef de
  // Division). Voit ce que voit son superviseur (CascadeService) mais son
  // niveau de confidentialité et son autorité d'action restent les siens.
  ASSISTANT_DIRECTION
  // Directeur des Ressources Humaines — module Dossier du personnel
  // uniquement (lecture/écriture sur tous les dossiers, import Excel).
  // Fonction transversale exactement comme ADMIN_SYSTEME (voir
  // CascadeService, TOP_LEVEL_ROLES) : aucune autorité de cascade sur
  // tâches/documents/congés (jamais dans LEADERSHIP_ROLES). Distinct du
  // CHEF_CELLULE de la cellule RH — les deux rôles peuvent coexister sur
  // des comptes différents, ou non, décision organisationnelle hors du
  // périmètre applicatif.
  DRH
  // Stagiaire (D6) — accès restreint par liste blanche (StagiaireGuard) :
  // ses propres tâches, la messagerie, les annonces, son dossier et son
  // stage. Aucune visibilité passive (tâches de la section, GED privée,
  // courrier), aucune autorité. Rattachement optionnel, tenu par la
  // rotation des stages (StagesService).
  STAGIAIRE

  @@map("system_role")
}

enum UserStatus {
  EN_ATTENTE // auto-inscription en attente de validation par l'administrateur
  ACTIF
  SUSPENDU
  // Suppression LOGIQUE d'un compte par l'administrateur — distinct de
  // SUSPENDU (réversible sans distinction fonctionnelle entre les deux à ce
  // stade, mais un statut dédié plutôt qu'un réemploi de SUSPENDU garde le
  // motif explicite dans l'historique). Ni le compte ni rien de ce qui lui
  // est lié (tâches créées/assignées, messages, commentaires, entrées
  // d'audit...) n'est supprimé ni réattribué — seule la connexion est
  // bloquée (JwtAuthGuard/AuthService.login, comme SUSPENDU) et le compte
  // disparaît des surfaces qui filtrent déjà sur status: ACTIF (annuaire,
  // ciblage tâches/annonces/sondages, notifications...). Reste visible dans
  // la gestion des comptes (GET /users, sans filtre de statut) pour
  // traçabilité et réactivation éventuelle.
  SUPPRIME

  @@map("user_status")
}

enum TaskStatus {
  A_FAIRE
  EN_COURS
  SOUMISE_VALIDATION
  VALIDEE
  REJETEE
  TERMINEE

  @@map("task_status")
}

enum TaskPriority {
  URGENT
  NORMAL
  FAIBLE

  @@map("task_priority")
}

enum TaskConfidentiality {
  PUBLIC_INTERNE
  CONFIDENTIEL_DIVISION
  TRES_CONFIDENTIEL_DIRIGEANTS

  @@map("task_confidentiality")
}

enum TaskAssigneeRole {
  RESPONSABLE // un seul = responsable unique ; plusieurs = co-responsabilité
  COLLABORATEUR // collaborateur en soutien

  @@map("task_assignee_role")
}

enum RecurrenceFrequency {
  QUOTIDIENNE
  HEBDOMADAIRE
  MENSUELLE

  @@map("recurrence_frequency")
}

enum DocumentCategory {
  ETUDE
  RAPPORT
  NOTE_TECHNIQUE
  AUTRE

  @@map("document_category")
}

enum DocumentVisibility {
  PRIVE_DIVISION
  PUBLIE_DNPEC

  @@map("document_visibility")
}

enum LeaveRequestStatus {
  EN_ATTENTE
  APPROUVEE
  REJETEE
  ANNULEE

  @@map("leave_request_status")
}

enum AnnouncementScope {
  DNPEC
  DIVISION
  SECTION
  // Symétrique à DIVISION pour les cellules transversales (SAF, RH, CSID —
  // CTSCM/CNC n'ont pas encore de chef, cf. Cellule.chefId).
  CELLULE
  GROUPE_PERSONNALISE

  @@map("announcement_scope")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS

  @@map("notification_channel")
}

enum NotificationType {
  TACHE_ASSIGNEE
  TACHE_ECHEANCE_PROCHE
  TACHE_EN_RETARD
  TACHE_SOUMISE_VALIDATION
  TACHE_VALIDEE
  TACHE_REJETEE
  MENTION_COMMENTAIRE
  MESSAGE_DIRECT
  ANNONCE
  CONGE_SOUMIS
  CONGE_VALIDE
  CONGE_REJETE
  DOCUMENT_PUBLIE
  REUNION_PLANIFIEE
  REUNION_RAPPEL
  REUNION_ANNULEE
  SONDAGE_CREE
  SUGGESTION_RECUE
  SUGGESTION_STATUT_MAJ
  DOSSIER_ERREUR_SIGNALEE
  DECISION_RELANCE
  SUPPLEANCE_DESIGNEE
  // Courrier et actes (D7)
  COURRIER_A_IMPUTER
  COURRIER_IMPUTE
  PLI_PERSONNEL_RECU
  COURRIER_ACCES_OUVERT
  IMPUTATION_ECHEANCE_PROCHE
  IMPUTATION_EN_RETARD
  ACTE_A_VISER
  ACTE_RENVOYE
  ACTE_A_SIGNER
  ACTE_SIGNE
  ACTE_PRISE_CONNAISSANCE
  ROLE_MODIFIE // changement de rôle d'un compte (personne concernée et DRH)
  SUPPLEANCE_REVOQUEE // suppléance révoquée (ex. devenue non conforme après un changement de rôle)
  // Stages (D6)
  STAGE_PERIODE_A_ACCEPTER // au responsable de l'unité d'accueil
  STAGE_PERIODE_REFUSEE // au DRH
  STAGE_PERIODE_A_VENIR // 3 jours avant : stagiaire, tuteur, responsable
  STAGE_PERIODE_DEBUT // changement d'unité appliqué
  STAGE_ALERTE // au DRH : période non acceptée à sa date, unité suspendue, compte inactif
  STAGE_PLAN_MODIFIE // tuteurs et responsables concernés
  STAGE_EVALUATION_A_FAIRE
  STAGE_EVALUATION_A_VISER
  STAGE_EVALUATION_RENVOYEE
  STAGE_EVALUATION_VISEE
  // Logistique (D9)
  LOGISTIQUE_DEMANDE_A_VALIDER // au chef direct du demandeur
  LOGISTIQUE_DEMANDE_A_TRAITER // aux gestionnaires logistiques
  LOGISTIQUE_DEMANDE_TRAITEE // au demandeur
  LOGISTIQUE_DEMANDE_REFUSEE // au demandeur
  LOGISTIQUE_STOCK_BAS // aux gestionnaires : article passé sous son seuil
  BIEN_A_RECUPERER // aux gestionnaires : détenteur d'un bien parti (compte inactif)
  RESERVATION_A_VALIDER // aux gestionnaires (ressource en mode validation)
  RESERVATION_CONFIRMEE // au titulaire, après validation
  RESERVATION_REFUSEE // au titulaire
  RESERVATION_ANNULEE // au titulaire, annulation par un gestionnaire
  RESERVATION_ANNULEE_PRIORITE // au titulaire évincé, avec le nom du prioritaire

  @@map("notification_type")
}

enum AuditAction {
  CREATION
  MODIFICATION
  SUPPRESSION
  VALIDATION
  REJET
  PUBLICATION
  CONNEXION
  DECONNEXION

  @@map("audit_action")
}

// ----------------------------------------------------------------------------
// Organisation — Divisions & Sections (§2)
// ----------------------------------------------------------------------------

model Division {
  id        String   @id @default(cuid())
  code      String   @unique // DPE, DEE, DSPS, DAC, DIPE
  name      String
  // Suspension (§2.3) : n'affecte JAMAIS les personnes déjà rattachées
  // (elles gardent connexion, tâches, congés, documents intacts) — bloque
  // uniquement la croissance de l'unité pendant qu'elle est fausse : nouveau
  // rattachement (inscription, création manuelle, approbation) et nomination
  // d'un nouveau chef. Voir DivisionsService.suspend/reactivate.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections      Section[]
  users         User[]
  tasks         Task[]
  projects      Project[]
  folders       Folder[]
  documents     Document[]
  announcements Announcement[]
  Poll          Poll[]

  periodesStage    PeriodeStage[]
  affectationsBien AffectationBien[] @relation("AffectationBienDivision")

  // Socle NIMBA (N1) : unité organisationnelle correspondante.
  unite UniteOrganisationnelle?

  @@map("divisions")
}

model Section {
  id         String   @id @default(cuid())
  code       String // SSR, SFP, SSME, SGOP, SE, SDP, SME, ...
  name       String
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  // Voir Division.isActive — même principe de suspension, appliqué indépendamment
  // au niveau de la Section (une Section peut être suspendue sans que sa Division
  // le soit, et inversement).
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users         User[]
  tasks         Task[]
  announcements Announcement[]
  Poll          Poll[]

  periodesStage    PeriodeStage[]
  affectationsBien AffectationBien[] @relation("AffectationBienSection")

  // Socle NIMBA (N1) : unité organisationnelle correspondante.
  unite UniteOrganisationnelle?

  @@unique([divisionId, code])
  @@map("sections")
}

// Cellules transversales rattachées directement au DN ou à la DNA (§2) :
// CTSCM, CNC (sous le DN), SAF, RH, CSID (sous la DNA). Contrairement aux
// Divisions, elles ne comportent pas de Sections. Les 5 cellules officielles
// sont fournies en données de seed (prisma/seed.ts).
model Cellule {
  id   String @id @default(cuid())
  code String @unique // CTSCM, CNC, SAF, RH, CSID
  name String

  // Chef de cellule (rôle CHEF_CELLULE) : renseigné pour SAF, RH, CSID ;
  // reste null pour CTSCM et CNC tant que leur structure interne n'est pas
  // définie (§11 — itération future). @unique car une même personne ne
  // dirige qu'une seule cellule.
  chefId String? @unique
  chef   User?   @relation("CelluleChef", fields: [chefId], references: [id])

  // Voir Division.isActive — même principe de suspension. Une Cellule suspendue
  // garde son chef actuel (aucun effet sur lui) mais ne peut pas en recevoir un
  // nouveau tant qu'elle est suspendue (CellulesService.assignChef).
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Rattachement général (membres, y compris le chef lui-même)
  users         User[]
  tasks         Task[]
  announcements Announcement[]
  Poll          Poll[]

  // Socle N4 : espace documentaire de la cellule (document produit par la cellule).
  documents Document[]

  periodesStage    PeriodeStage[]
  affectationsBien AffectationBien[] @relation("AffectationBienCellule")

  // Socle NIMBA (N1) : unité organisationnelle correspondante (Cellule ou Instance).
  unite UniteOrganisationnelle?

  @@map("cellules")
}

// ----------------------------------------------------------------------------
// Utilisateurs (§3)
// ----------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  photoUrl     String?
  role         SystemRole
  status       UserStatus @default(EN_ATTENTE)
  // Intitulé de poste affiché — ex. "Chargé d'Études" pour un Agent de
  // Division, ou l'intitulé réel pour un Agent d'une cellule transversale
  // (RH, SAF, CTSCM, CNC, CSID). Purement déclaratif : ne change pas le
  // niveau de permission, porté uniquement par `role`.
  jobTitle     String?

  // Rattachement organisationnel (§2.1, cascade hiérarchique). Un utilisateur
  // est rattaché à une Division OU à une Cellule, jamais les deux
  // (invariant applicatif — voir en-tête de fichier, décision n°4) :
  // - DN / DNA                  -> divisionId = null, celluleId = null,
  //   sectionId = null
  // - ASSISTANT_DIRECTION       -> divisionId = null, celluleId = null,
  //   sectionId = null, supervisorId requis (voir plus bas)
  // - CHEF_DIVISION             -> divisionId requis, celluleId = null,
  //   sectionId = null
  // - CHEF_SECTION              -> divisionId + sectionId requis,
  //   celluleId = null
  // - AGENT (personnel de Division, affiché "Chargé d'Études")
  //                             -> divisionId requis, celluleId = null,
  //   sectionId nullable (RF-SEC-06 : rattachement à une Division seule,
  //   en attendant affectation à une Section)
  // - AGENT (personnel d'une cellule transversale)
  //                             -> celluleId requis, divisionId = null,
  //   sectionId = null
  // - CHEF_CELLULE (SAF, RH, CSID uniquement pour l'instant)
  //                             -> celluleId requis = la cellule qu'il
  //   dirige (donc Cellule.chefId de cette cellule pointe vers ce User),
  //   divisionId = null, sectionId = null
  // - ADMIN_SYSTEME             -> typiquement celluleId = CSID,
  //   divisionId = null, sectionId = null
  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id])
  sectionId  String?
  section    Section?  @relation(fields: [sectionId], references: [id])
  celluleId  String?
  cellule    Cellule?  @relation(fields: [celluleId], references: [id])

  // Rattachement SOUHAITÉ, déclaré par la personne elle-même lors de
  // l'auto-inscription (RF-SEC-01, modalité 2) — jamais posé automatiquement
  // comme divisionId/sectionId/celluleId ci-dessus, qui restent entièrement
  // la décision de l'admin à l'approbation (UsersService.approveRegistration).
  // Pas de relation Prisma (délibéré) : purement informatif, affiché à
  // l'admin pour pré-remplir le formulaire d'approbation, jamais utilisé
  // pour un contrôle de permission ni un filtre de cascade. Exclusivité à
  // trois (Division / Cellule / Assistant de direction), validée dans
  // AuthService.register.
  declaredDivisionId   String?
  declaredSectionId    String?
  declaredCelluleId    String?
  // Idem, pour la déclaration "Assistant de direction" — la personne choisie
  // doit avoir le rôle DN, DNA ou CHEF_CELLULE et être ACTIF (même invariant
  // que supervisorId ci-dessus), validé dans AuthService.register.
  declaredSupervisorId String?
  // Poste actuel déclaré par la personne elle-même à l'inscription (ex.
  // "CHEF_DIVISION") — String simple et non un SystemRole : délibérément
  // découplé du champ `role` réel, purement informatif pour aider l'admin à
  // choisir le rôle à l'approbation (voir ApproveRegistrationModal côté web,
  // qui l'utilise pour pré-sélectionner le rôle sans jamais l'attribuer
  // automatiquement). Valeurs acceptées listées dans RegisterDto.
  declaredRole         String?

  // Cellule dont cet utilisateur est le chef (réciproque de Cellule.chefId) —
  // distinct de `cellule` ci-dessus qui porte le simple rattachement/membre.
  celluleLed Cellule? @relation("CelluleChef")

  // Assistant(e) de direction (ASSISTANT_DIRECTION) : personne assistée, au
  // lieu d'un rattachement à une Division — DN, DNA ou CHEF_CELLULE
  // uniquement (voir en-tête de fichier, décision de conception n°2 et
  // invariant n°4).
  supervisorId String?
  supervisor   User?   @relation("AssistantSupervisors", fields: [supervisorId], references: [id])
  assistants   User[]  @relation("AssistantSupervisors")

  // Sécurité (§3.3, §7.3, RF-SEC-02/03/05)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String? // secret TOTP, chiffré au repos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]

  // Tâches
  createdTasks    Task[]               @relation("TaskCreatedBy")
  submittedTasks  Task[]               @relation("TaskSubmittedBy")
  validatedTasks  Task[]               @relation("TaskValidatedBy")
  taskAssignments TaskAssignee[]
  taskComments    TaskComment[]
  commentMentions TaskCommentMention[]
  taskAttachments TaskAttachment[]
  savedFilters    SavedFilter[]
  createdProjects Project[]            @relation("ProjectCreatedBy")

  // GED
  createdFolders           Folder[]
  createdDocuments         Document[]        @relation("DocumentCreatedBy")
  publishedDocuments       Document[]        @relation("DocumentPublishedBy")
  uploadedDocumentVersions DocumentVersion[]

  // Congés
  leaveRequestsMade    LeaveRequest[] @relation("LeaveRequester")
  leaveRequestsDecided LeaveRequest[] @relation("LeaveApprover")
  leaveBalances        LeaveBalance[]

  // Communication
  sentMessages           DirectMessage[]         @relation("MessageSender")
  receivedMessages       DirectMessage[]         @relation("MessageRecipient")
  createdAnnouncements   Announcement[]
  announcementRecipients AnnouncementRecipient[]
  announcementReads      AnnouncementRead[]

  // Sondages
  createdPolls   Poll[]
  pollVotes      PollVote[]
  pollRecipients PollRecipient[]

  // Boîte à suggestions
  submittedSuggestions Suggestion[] @relation("SuggestionAuthor")
  respondedSuggestions Suggestion[] @relation("SuggestionRespondedBy")

  // Réunions
  organizedMeetings     Meeting[]            @relation("MeetingOrganizer")
  meetingParticipations MeetingParticipant[]

  // Décisions de réunion (D2)
  createdDecisions Decision[] @relation("DecisionCreatedBy")
  closedDecisions  Decision[] @relation("DecisionClosedBy")

  notifications Notification[]
  auditLogs     AuditLog[]

  // Dossier du personnel (module personnel/) — voir en-tête de
  // PersonnelFileBasic/Sensitive pour la séparation des deux niveaux de
  // sensibilité.
  personnelFileBasic     PersonnelFileBasic?
  personnelFileSensitive PersonnelFileSensitive?
  personnelDiplomas      PersonnelDiploma[]      @relation("PersonnelDiplomaOwner")
  personnelDocuments     PersonnelDocument[]     @relation("PersonnelDocumentOwner")
  uploadedPersonnelDocs  PersonnelDocument[]     @relation("PersonnelDocumentUploadedBy")
  personnelCareerEvents  PersonnelCareerEvent[]  @relation("PersonnelCareerEventSubject")
  recordedCareerEvents   PersonnelCareerEvent[]  @relation("PersonnelCareerEventRecordedBy")

  // Suppléance/intérim (§4.10)
  suppleancesAsTitulaire Suppleance[] @relation("SuppleanceTitulaire")
  suppleancesAsSuppleant Suppleance[] @relation("SuppleanceSuppleant")
  suppleancesDesignated  Suppleance[] @relation("SuppleanceCreatedBy")
  suppleancesRevoked     Suppleance[] @relation("SuppleanceRevokedBy")
  auditLogsOnBehalfOf    AuditLog[]   @relation("AuditOnBehalfOf")

  // Courrier et actes (D7)
  habilitationsCourrier        HabilitationCourrier[] @relation("HabilitationCourrierUser")
  habilitationsCourrierDonnees HabilitationCourrier[] @relation("HabilitationCourrierAccordeePar")
  habilitationsCourrierRevoq   HabilitationCourrier[] @relation("HabilitationCourrierRevoqueePar")
  arriveesEnregistrees         CourrierArrivee[]      @relation("ArriveeEnregistreePar")
  arriveesDestinataire         CourrierArrivee[]      @relation("ArriveeDestinataire")
  arriveesClassees             CourrierArrivee[]      @relation("ArriveeClasseePar")
  arriveesAnnulees             CourrierArrivee[]      @relation("ArriveeAnnuleePar")
  imputationsFaites            ImputationCourrier[]   @relation("ImputationImputePar")
  imputationsAuNomDe           ImputationCourrier[]   @relation("ImputationAuNomDe")
  imputationsRecues            ImputationCourrier[]   @relation("ImputationImputeA")
  imputationsTraitees          ImputationCourrier[]   @relation("ImputationTraiteePar")
  actesRediges                 ActeCourrier[]         @relation("ActeRedacteur")
  actesBeneficiaire            ActeCourrier[]         @relation("ActeBeneficiaire")
  actesSignes                  ActeCourrier[]         @relation("ActeSignataire")
  actesSignesAuNomDe           ActeCourrier[]         @relation("ActeSigneAuNomDe")
  actesExpedies                ActeCourrier[]         @relation("ActeExpediePar")
  actesAnnules                 ActeCourrier[]         @relation("ActeAnnulePar")
  visasAttendus                VisaActe[]             @relation("VisaViseurAttendu")
  visasPoses                   VisaActe[]             @relation("VisaVisePar")
  visasAuNomDe                 VisaActe[]             @relation("VisaViseAuNomDe")
  piecesCourrierDeposees       PieceCourrier[]
  accesDelegueRecus            AccesDelegueCourrier[] @relation("AccesDelegueBeneficiaire")
  accesDelegueOuverts          AccesDelegueCourrier[] @relation("AccesDelegueOuvertPar")
  accesDelegueRevoques         AccesDelegueCourrier[] @relation("AccesDelegueRevoquePar")

  // Stages (D6)
  stagesSuivis        Stage[]             @relation("StageStagiaire")
  stagesCrees         Stage[]             @relation("StageCreePar")
  periodesTutorees    PeriodeStage[]      @relation("PeriodeTuteur")
  periodesDecidees    PeriodeStage[]      @relation("PeriodeDecideePar")
  evaluationsRedigees EvaluationStage[]   @relation("EvaluationRedacteur")
  evaluationsVisees   EvaluationStage[]   @relation("EvaluationViseePar")
  capacitesFixees     CapaciteAccueil[]   @relation("CapaciteFixeePar")
  modelesAttestation  ModeleAttestation[] @relation("ModeleAttestationImportePar")

  // Logistique (D9)
  habilitationsLogistique          HabilitationLogistique[] @relation("HabLogUser")
  habilitationsLogistiqueAccordees HabilitationLogistique[] @relation("HabLogAccordeePar")
  habilitationsLogistiqueRevoquees HabilitationLogistique[] @relation("HabLogRevoqueePar")
  biensCrees                       Bien[]                   @relation("BienCreePar")
  affectationsBien                 AffectationBien[]        @relation("AffectationDetenteur")
  affectationsBienFaites           AffectationBien[]        @relation("AffectationFaitePar")
  mouvementsBien                   MouvementBien[]          @relation("MouvementBienPar")
  demandesLogistique               DemandeLogistique[]      @relation("DemandeDemandeur")
  demandesLogistiqueValidees       DemandeLogistique[]      @relation("DemandeValideur")
  demandesLogistiqueTraitees       DemandeLogistique[]      @relation("DemandeTraiteePar")
  demandesLogistiqueRefusees       DemandeLogistique[]      @relation("DemandeRefuseePar")
  mouvementsStock                  MouvementStock[]         @relation("MouvementStockPar")
  reservations                     Reservation[]            @relation("ReservationTitulaire")
  reservationsCreees               Reservation[]            @relation("ReservationCreeePar")
  reservationsDecidees             Reservation[]            @relation("ReservationDecideePar")
  reservationsAnnulees             Reservation[]            @relation("ReservationAnnuleePar")
  reservationsPrioritaires         Reservation[]            @relation("ReservationPrioritaire")

  // Socle NIMBA (N1) — agent (personne physique) auquel ce compte est rattaché.
  // Facultatif en base (compte en attente d'approbation, rétrocompatibilité) ;
  // « aucun compte actif sans agent » est garanti par l'application en N1,
  // par une contrainte en base à partir de N2.
  agentId                   String?                  @unique
  agent                     Agent?                   @relation("AgentCompte", fields: [agentId], references: [id])
  unitesDirigees            UniteOrganisationnelle[] @relation("UniteResponsable")
  unitesFermees             UniteOrganisationnelle[] @relation("UniteFermeePar")
  historiqueUnitesAuteur    HistoriqueUnite[]        @relation("HistoriqueUniteAuteur")
  mouvementsAgentAuteur     MouvementAgent[]         @relation("MouvementAgentAuteur")
  attributionsRoles         AttributionRole[]        @relation("AttributionRoleCompte")
  attributionsRolesDonnees  AttributionRole[]        @relation("AttributionRoleAttribuePar")
  attributionsRolesRetirees AttributionRole[]        @relation("AttributionRoleRetirePar")
  // Socle N4 — ordres de mission.
  ordresMission             OrdreMission[]           @relation("OrdreMissionAgent")
  ordresMissionCrees        OrdreMission[]           @relation("OrdreMissionCreePar")
  // Socle N5 — plan de travail, messagerie en fils, préférences, instructions.
  activitesResponsable      Activite[]               @relation("ActiviteResponsable")
  participationsFils        ParticipantFil[]         @relation("ParticipantFilCompte")
  messagesFil               MessageFil[]             @relation("MessageFilAuteur")
  preferenceNotification    PreferenceNotification?  @relation("PreferenceNotificationCompte")
  instructionsEmises        Instruction[]            @relation("InstructionEmetteur")
  instructionsRecues        Instruction[]            @relation("InstructionDestinataire")
  instructionsConcernant    Instruction[]            @relation("InstructionAgentConcerne")

  @@map("users")
}

// Sessions actives, pour la fonction de déconnexion à distance / partout
// (RF-SEC-05) — la session n'expire pas automatiquement (§3.3).
model UserSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceLabel      String? // ex. "Chrome sur Windows", "App mobile Android"
  refreshTokenHash String
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?

  @@map("user_sessions")
}

// Jetons de réinitialisation de mot de passe (mot de passe oublié). Même
// principe de sécurité que UserSession.refreshTokenHash : seul le SHA-256 du
// jeton est stocké, jamais le jeton en clair (voir PasswordResetService) — la
// valeur envoyée par email a 32 octets d'entropie aléatoire, un hachage lent
// n'apporte rien ici. `usedAt` rend un jeton à usage unique même avant
// expiration ; `expiresAt` le rend caduc après une heure (voir AuthService).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@map("password_reset_tokens")
}

// ----------------------------------------------------------------------------
// Module Tâches (RF-TAC-*)
// ----------------------------------------------------------------------------

// Regroupement de tâches sous un Projet/Dossier (RF-TAC-13)
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  divisionId  String?
  division    Division? @relation(fields: [divisionId], references: [id])
  createdById String
  createdBy   User      @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks Task[]

  @@map("projects")
}

model Task {
  id              String              @id @default(cuid())
  title           String
  description     String?
  status          TaskStatus          @default(A_FAIRE)
  priority        TaskPriority        @default(NORMAL)
  confidentiality TaskConfidentiality @default(PUBLIC_INTERNE)
  dueDate         DateTime?

  // Pièce jointe obligatoire avant de passer à SOUMISE_VALIDATION (voir
  // TasksService.submit). Uniquement significatif pour une tâche racine —
  // les sous-tâches ne passent jamais par ce statut (voir toggleSubtaskCompletion),
  // donc ce champ n'a aucun effet si posé sur l'une d'elles.
  documentRequired Boolean @default(false)

  // Périmètre d'origine de la tâche, dénormalisé pour les filtres et
  // tableaux de bord (RF-TAC-11, RF-TAC-12). divisionId/sectionId pour une
  // tâche de Division ; celluleId pour une tâche portée par une cellule
  // transversale (SAF/RH/CSID) — mutuellement exclusifs, comme pour User.
  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id])
  sectionId  String?
  section    Section?  @relation(fields: [sectionId], references: [id])
  celluleId  String?
  cellule    Cellule?  @relation(fields: [celluleId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  // Sous-tâches (RF-TAC-04) — dès qu'il en existe au moins une, progressPercent
  // est calculé automatiquement par l'application à partir de leur avancement
  // (voir TasksService.recomputeParentProgress) et n'est plus modifiable à la
  // main. Une tâche SANS sous-tâche peut au contraire recevoir une valeur
  // manuelle (TasksService.updateProgress, réservé au créateur/responsable) —
  // les deux mécanismes ne coexistent jamais : l'un ou l'autre selon qu'il
  // existe des sous-tâches à l'instant considéré, jamais les deux ensemble.
  parentTaskId    String?
  parentTask      Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks        Task[]  @relation("TaskSubtasks")
  progressPercent Int?

  // Tâches récurrentes (RF-TAC-09)
  isRecurring           Boolean              @default(false)
  recurrenceFrequency   RecurrenceFrequency?
  recurrenceEndDate     DateTime?
  // Tâche modèle à l'origine de cette occurrence générée automatiquement
  recurrenceSourceId    String?
  recurrenceSource      Task?                @relation("TaskRecurrenceOccurrences", fields: [recurrenceSourceId], references: [id])
  recurrenceOccurrences Task[]               @relation("TaskRecurrenceOccurrences")

  createdById String
  createdBy   User   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  // D2 — action générée depuis une décision de réunion (voir Decision.action) :
  // TasksService.validate clôture automatiquement la décision liée dès que
  // cette tâche passe à TERMINEE.
  sourceDecisionId String?   @unique
  sourceDecision   Decision? @relation("DecisionAction", fields: [sourceDecisionId], references: [id])

  // D7 — tâche générée depuis une imputation de courrier (conversion manuelle,
  // même modèle que D2) : TasksService.validate passe l'imputation liée à
  // TRAITEE dès que cette tâche est terminée.
  sourceImputationId String?             @unique
  sourceImputation   ImputationCourrier? @relation("ImputationTache", fields: [sourceImputationId], references: [id])

  // Workflow de validation (§4.1)
  submittedById     String?
  submittedBy       User?     @relation("TaskSubmittedBy", fields: [submittedById], references: [id])
  submittedAt       DateTime?
  validatedById     String?
  validatedBy       User?     @relation("TaskValidatedBy", fields: [validatedById], references: [id])
  validatedAt       DateTime?
  validationComment String?
  completedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignees      TaskAssignee[]
  comments       TaskComment[]
  attachments    TaskAttachment[]
  documents      Document[]       @relation("DocumentSourceTask")
  // Socle N5 — activité du plan de travail et alertes d'échéance (envoyées une fois).
  activiteId     String?
  activite       Activite?        @relation(fields: [activiteId], references: [id], onDelete: SetNull)
  alerteVeilleAt DateTime?
  alerteRetardAt DateTime?

  @@map("tasks")
}

// Responsables / co-responsables / collaborateurs en soutien (RF-TAC-02) :
// plusieurs lignes RESPONSABLE = co-responsabilité ; une ligne RESPONSABLE +
// plusieurs COLLABORATEUR = responsable unique avec soutien.
model TaskAssignee {
  id         String           @id @default(cuid())
  taskId     String
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleOnTask TaskAssigneeRole @default(RESPONSABLE)
  assignedAt DateTime         @default(now())

  @@unique([taskId, userId])
  @@map("task_assignees")
}

// Fil de commentaires avec mentions @nom (RF-TAC-08)
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentions TaskCommentMention[]

  @@map("task_comments")
}

model TaskCommentMention {
  id              String      @id @default(cuid())
  commentId       String
  comment         TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser   User        @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([commentId, mentionedUserId])
  @@map("task_comment_mentions")
}

// Pièces jointes directement liées à une tâche (RF-TAC-05) — distinct du
// module GED (Document) qui gère versions + publication institutionnelle.
model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileKey      String // chemin objet MinIO/S3
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@map("task_attachments")
}

// Recherches/filtres favoris (RF-TAC-11)
model SavedFilter {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  filterJson Json
  createdAt  DateTime @default(now())

  @@map("saved_filters")
}

// ----------------------------------------------------------------------------
// Module Archivage / GED (RF-GED-*)
// ----------------------------------------------------------------------------

// Organisation libre en dossiers/sous-dossiers propre à chaque division
// (RF-GED-04), en complément des catégories fixes portées par Document.
model Folder {
  id             String   @id @default(cuid())
  divisionId     String
  division       Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  parentFolderId String?
  parentFolder   Folder?  @relation("FolderTree", fields: [parentFolderId], references: [id])
  subFolders     Folder[] @relation("FolderTree")
  name           String
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  documents Document[]

  @@map("folders")
}

model Document {
  id          String             @id @default(cuid())
  title       String
  description String?
  category    DocumentCategory   @default(AUTRE)
  visibility  DocumentVisibility @default(PRIVE_DIVISION)
  // Seuls les documents marqués "Final" peuvent être publiés (RF-GED-03)
  isFinal     Boolean            @default(false)

  // Unité productrice : une division OU (socle N4) une cellule rattachée à la Direction —
  // exactement l'une des deux (CHECK documents_unite_productrice). Dossiers : divisions seulement.
  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  celluleId  String?
  cellule    Cellule?  @relation(fields: [celluleId], references: [id], onDelete: Restrict)
  folderId   String?
  folder     Folder?   @relation(fields: [folderId], references: [id])

  // Document issu d'une tâche (§4.3 : "le document peut être lié
  // directement à la tâche dont il est issu")
  sourceTaskId    String?
  sourceTask      Task?    @relation("DocumentSourceTask", fields: [sourceTaskId], references: [id])
  // Socle N4 — ou de la réunion (SIG-RF-GED-08).
  sourceMeetingId String?
  sourceMeeting   Meeting? @relation("DocumentSourceMeeting", fields: [sourceMeetingId], references: [id], onDelete: SetNull)

  // Socle N4 — statut de diffusion (§7.1) et métadonnées obligatoires (§8, SIG-RF-GED-07).
  statutDiffusion StatutDiffusion @default(BROUILLON)
  typeDocument    TypeDocument    @default(AUTRE)
  dateDocument    DateTime        @default(now()) @db.Date
  periodeDebut    DateTime?       @db.Date
  periodeFin      DateTime?       @db.Date

  // Pointeur vers la version courante ; l'historique complet vit dans
  // DocumentVersion (RF-GED-03 : conservation de l'historique des versions).
  currentVersionId String?           @unique
  currentVersion   DocumentVersion?  @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id])
  versions         DocumentVersion[] @relation("DocumentVersions")

  // Publication institutionnelle réservée au DN/DNA et aux Chefs de Division
  // (RF-GED-02)
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("DocumentPublishedBy", fields: [publishedById], references: [id])

  createdById String
  createdBy   User     @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("documents")
}

model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  fileName      String
  fileKey       String // chemin objet MinIO/S3
  mimeType      String
  sizeBytes     Int
  // Texte extrait par OCR (Tesseract) pour la recherche full-text sur les
  // PDF scannés (RF-GED-06) — indexé dans Meilisearch en parallèle.
  ocrText       String?
  uploadedById  String
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime @default(now())

  documentCurrent Document? @relation("DocumentCurrentVersion")

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

// ----------------------------------------------------------------------------
// Module Congés et Absences (RF-CNG-*)
// ----------------------------------------------------------------------------

// Table (et non enum) car les types de congés sont explicitement
// extensibles par la CSID sans redéploiement (§4.4).
model LeaveType {
  id   String @id @default(cuid())
  code String @unique // CONGE_ANNUEL, CONGE_MALADIE, MISSION, ...
  name String

  requests LeaveRequest[]
  balances LeaveBalance[]

  @@map("leave_types")
}

model LeaveRequest {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType          @relation(fields: [leaveTypeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  daysCount   Float
  reason      String?
  status      LeaveRequestStatus @default(EN_ATTENTE)

  // Validation par le supérieur hiérarchique direct, en cascade (§2.1)
  approverId      String?
  approver        User?     @relation("LeaveApprover", fields: [approverId], references: [id])
  decisionComment String?
  decidedAt       DateTime?

  // Socle N3 — circuit A6.1 : avis du chef d'unité (FAVORABLE | DEFAVORABLE | TACITE, réputé
  // favorable passé l'échéance de 48 heures ouvrées, paramètre), puis décision du DRH
  // (approverId / decidedAt ci-dessus). Alerte au chef 12 heures ouvrées avant l'échéance.
  avisEtat     String?
  avisParId    String?
  avisMotif    String?
  avisLe       DateTime?
  avisEcheance DateTime?
  alerteAvisAt DateTime?

  // Socle N3 — certificat médical d'un congé maladie : déposé par l'agent, lisible de lui et du
  // DRH seuls (jamais du chef qui donne l'avis, du DN ni de la DNA).
  certificatFileKey  String?
  certificatFileName String?
  certificatDeposeLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, avisEtat])
  @@map("leave_requests")
}

/// Jour férié de Guinée (socle N3) : saisi année par année par l'administrateur ou le DRH ; exclu du
/// délai d'avis en heures ouvrées et du décompte des jours de congé. nature : FIXE | RELIGIEUX.
model JourFerie {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  libelle   String
  nature    String   @default("FIXE")
  creeParId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("jours_feries")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  totalDays   Float
  usedDays    Float     @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, leaveTypeId, year])
  @@map("leave_balances")
}

// ----------------------------------------------------------------------------
// Module Communication (RF-COM-*)
// ----------------------------------------------------------------------------

model DirectMessage {
  id             String    @id @default(cuid())
  senderId       String
  sender         User      @relation("MessageSender", fields: [senderId], references: [id])
  recipientId    String
  recipient      User      @relation("MessageRecipient", fields: [recipientId], references: [id])
  body           String
  attachmentKey  String?
  attachmentName String?
  // Accusé de lecture horodaté (§4.2 : "vu à 14h32")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@map("direct_messages")
}

// Annonces (messages groupés) ciblées en cascade hiérarchique (RF-COM-02).
// Le ciblage DNPEC/Division/Section/Cellule est porté par scope +
// divisionId/sectionId/celluleId ; le ciblage "groupe personnalisé" passe
// par AnnouncementRecipient.
model Announcement {
  id         String            @id @default(cuid())
  authorId   String
  author     User              @relation(fields: [authorId], references: [id])
  title      String
  body       String
  scope      AnnouncementScope
  divisionId String?
  division   Division?         @relation(fields: [divisionId], references: [id])
  sectionId  String?
  section    Section?          @relation(fields: [sectionId], references: [id])
  celluleId  String?
  cellule    Cellule?          @relation(fields: [celluleId], references: [id])
  createdAt  DateTime          @default(now())

  recipients AnnouncementRecipient[]
  reads      AnnouncementRead[]

  @@map("announcements")
}

model AnnouncementRecipient {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_recipients")
}

// Historisation intégrale des échanges (RF-COM-05) : les lectures d'annonces
// sont journalisées séparément des destinataires ciblés.
model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

// ----------------------------------------------------------------------------
// Module Sondages (RF-CPL-04) — décisions rapides à choix simples
// ----------------------------------------------------------------------------

// Ciblage (qui peut créer un sondage pour quel périmètre) rigoureusement
// identique aux annonces : même enum AnnouncementScope réutilisé tel quel
// (pas de doublon), même astuce de "cible synthétique" pour
// CascadeService.assertCanManageUser côté service (voir PollsService).
// Nominatif comme AnnouncementRead : qui a voté quoi n'est visible qu'à
// l'auteur et à la direction (DN/DNA/ADMIN_SYSTEME) — tout le monde d'autre
// ne voit que les totaux agrégés par option.
model Poll {
  id            String            @id @default(cuid())
  authorId      String
  author        User              @relation(fields: [authorId], references: [id])
  question      String
  // Choix unique par défaut (une nouvelle réponse remplace la précédente,
  // voir PollsService.vote) ; choix multiple optionnel à la création.
  allowMultiple Boolean           @default(false)
  scope         AnnouncementScope
  divisionId    String?
  division      Division?         @relation(fields: [divisionId], references: [id])
  sectionId     String?
  section       Section?          @relation(fields: [sectionId], references: [id])
  celluleId     String?
  cellule       Cellule?          @relation(fields: [celluleId], references: [id])
  // Échéance optionnelle (clôture automatique côté application, aucun job
  // planifié nécessaire : un vote après closesAt est simplement rejeté) et
  // clôture manuelle par l'auteur (POST /polls/:id/close).
  closesAt      DateTime?
  closedAt      DateTime?
  createdAt     DateTime          @default(now())

  options    PollOption[]
  votes      PollVote[]
  recipients PollRecipient[]

  @@map("polls")
}

model PollOption {
  id     String     @id @default(cuid())
  pollId String
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label  String
  order  Int        @default(0)
  votes  PollVote[]

  @@map("poll_options")
}

// @@unique sur les trois colonnes (pas juste pollId+userId) car le choix
// multiple autorise plusieurs lignes pour la même personne sur le même
// sondage — PollsService.vote supprime les lignes précédentes de la
// personne avant d'insérer, sauf si allowMultiple.
model PollVote {
  id       String     @id @default(cuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votedAt  DateTime   @default(now())

  @@unique([pollId, userId, optionId])
  @@map("poll_votes")
}

// Mêmes rôle et structure qu'AnnouncementRecipient : uniquement peuplé pour
// le scope GROUPE_PERSONNALISE, les autres scopes calculent l'audience à la
// volée (voir PollsService.visibilityWhere).
model PollRecipient {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@map("poll_recipients")
}

// ----------------------------------------------------------------------------
// Module Boîte à suggestions (RF-CPL-05) — décidément le plus simple des
// modules de communication : pas de ciblage cascade, pas de vote. Visibilité
// fixe : l'auteur voit ses propres suggestions (sauf anonymes, voir plus
// bas), DN/DNA voient tout. Changement de statut réservé au DN/DNA.
// ----------------------------------------------------------------------------

enum SuggestionStatus {
  RECUE
  EN_ETUDE
  RETENUE
  NON_RETENUE

  @@map("suggestion_status")
}

// authorId nullable : une suggestion soumise anonymement (isAnonymous=true)
// n'a délibérément aucun auteur enregistré, pas seulement masqué à l'écran —
// une vraie anonymisation, pas cosmétique. Conséquence acceptée : ni suivi
// personnel ("mes suggestions") ni notification de changement de statut ne
// sont possibles pour une suggestion anonyme, faute de destinataire.
model Suggestion {
  id            String           @id @default(cuid())
  authorId      String?
  author        User?            @relation("SuggestionAuthor", fields: [authorId], references: [id])
  isAnonymous   Boolean          @default(false)
  content       String
  status        SuggestionStatus @default(RECUE)
  response      String?
  respondedById String?
  respondedBy   User?            @relation("SuggestionRespondedBy", fields: [respondedById], references: [id])
  respondedAt   DateTime?
  createdAt     DateTime         @default(now())

  @@map("suggestions")
}

// ----------------------------------------------------------------------------
// Module Réunions (RF-CPL-03) — calendrier partagé de réunions
// ----------------------------------------------------------------------------

// Visibilité (MeetingsService.getMeetingVisibilityWhere, pas ici) : organisateur
// et participants toujours ; la hiérarchie directe des participants en lecture
// seule, via CascadeService.getVisibleUserWhereForLeadershipScope — réutilisé
// tel quel, aucune méthode de cascade dédiée aux réunions. Aucune autorité
// d'action dérivée de cette visibilité élargie : seul l'organisateur peut
// annuler sa réunion (une réunion est un artefact personnel d'agenda, pas du
// contenu métier délégué en cascade comme une tâche) — et, de la même façon,
// seul l'organisateur (le "président de séance", aucun champ dédié : c'est la
// même personne, décision de conception D2) peut créer/modifier/convertir/
// clôturer les Decision de sa réunion, même pour DN/DNA qui la voient par
// cascade : voir n'est pas gérer, comme partout ailleurs dans l'application.
model Meeting {
  id                 String        @id @default(cuid())
  title              String
  agenda             String? // ordre du jour, texte libre
  location           String? // lieu/salle : texte libre, pas de modèle Salle séparé (hors périmètre §4.6)
  startAt            DateTime
  endAt              DateTime?
  status             MeetingStatus @default(PLANIFIEE)
  cancelledAt        DateTime?
  cancellationReason String?
  // Anti-doublon du rappel envoyé par le job planifié (MeetingsService.sendDueReminders) :
  // posé une fois pour toutes à l'envoi, jamais réinitialisé.
  reminderSentAt     DateTime?

  // D2 — Décisions et actions de réunion :
  // - minutesText : partie narrative libre du compte-rendu, optionnelle — le
  //   relevé structuré, lui, ce sont les Decision liées (ci-dessous).
  // - isOpen : exception explicite à la visibilité "participants + hiérarchie"
  //   (RF-CPL-03/§4.6) — une réunion déclarée ouverte est visible à tout
  //   utilisateur authentifié, ainsi que ses décisions (qui héritent
  //   entièrement de la visibilité de leur réunion, aucun axe de
  //   confidentialité propre à Decision).
  minutesText String?
  isOpen      Boolean @default(false)

  createdById String
  createdBy   User     @relation("MeetingOrganizer", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants MeetingParticipant[]
  decisions    Decision[]

  // D9 — salle réservée depuis la réunion (au plus une réservation liée).
  reservation Reservation?

  // Socle N4 — documents de la GED issus de la réunion (SIG-RF-GED-08).
  documentsIssus Document[] @relation("DocumentSourceMeeting")

  @@map("meetings")
}

enum MeetingStatus {
  PLANIFIEE
  ANNULEE

  @@map("meeting_status")
}

// L'organisateur est aussi inséré ici (responseStatus CONFIRME dès la création,
// voir MeetingsService.create) pour apparaître dans la liste des participants
// sans avoir à répondre à sa propre invitation.
model MeetingParticipant {
  id             String                @id @default(cuid())
  meetingId      String
  meeting        Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  responseStatus MeetingResponseStatus @default(EN_ATTENTE)
  respondedAt    DateTime?

  @@unique([meetingId, userId])
  @@map("meeting_participants")
}

enum MeetingResponseStatus {
  EN_ATTENTE
  CONFIRME
  DECLINE

  @@map("meeting_response_status")
}

// Relevé de décisions d'une réunion (D2). Visibilité entièrement héritée de
// sa Meeting (voir commentaire du modèle Meeting) — jamais interrogée seule
// sans passer par le `where: { meeting: ... }` de DecisionsService. Création/
// modification/conversion/clôture réservées à l'organisateur de la réunion
// (le "président de séance") ; DN/DNA et la hiérarchie des participants qui
// la voient par cascade ne peuvent que consulter et relancer (notification),
// jamais agir directement — décision de conception D2.
model Decision {
  id        String         @id @default(cuid())
  meetingId String
  meeting   Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  content   String
  status    DecisionStatus @default(EN_ATTENTE)

  // Clôture manuelle (par l'organisateur) OU automatique dès que l'action
  // liée (Task.sourceDecisionId) passe à TERMINEE — voir TasksService.validate.
  closedAt   DateTime?
  closedById String?
  closedBy   User?     @relation("DecisionClosedBy", fields: [closedById], references: [id])

  createdById String
  createdBy   User     @relation("DecisionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Action générée (optionnelle) — la FK vit sur Task (voir Task.sourceDecisionId),
  // même sens que Document.sourceTaskId/Task.documents : le champ est porté par
  // l'artefact généré, pas par son origine.
  action Task? @relation("DecisionAction")

  @@map("decisions")
}

enum DecisionStatus {
  EN_ATTENTE // non exécutée — visible au tableau de bord du président/DN
  CLOTUREE

  @@map("decision_status")
}

// ----------------------------------------------------------------------------
// Notifications multi-canal (in-app + email + SMS — §4.2, RF-COM-03/04)
// ----------------------------------------------------------------------------

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel
  title     String
  body      String
  link      String? // lien profond vers la ressource concernée (tâche, message...)
  isRead    Boolean             @default(false)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  // Socle N5 — email regroupé dans le résumé quotidien : date d'envoi prévue (null = immédiat ou déjà parti).
  aEnvoyerLe DateTime?

  @@index([userId, isRead])
  @@map("notifications")
}

// ----------------------------------------------------------------------------
// Journal d'audit (RF-SEC-04) — traçabilité intégrale des actions
// ----------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id])
  action     AuditAction
  entityType String // ex. "Task", "Document", "LeaveRequest"
  entityId   String
  // Détail de l'action (champs modifiés, valeurs avant/après...)
  metadata   Json?

  // Suppléance/intérim (§4.10) : renseigné automatiquement par AuditService
  // (via RequestContext/AsyncLocalStorage, jamais passé explicitement par
  // les appelants) quand `actorId` a agi sous couvert d'une Suppleance
  // active au moment de la requête — "par intérim, au nom de". `actorId`
  // reste toujours la personne réelle qui a agi ; `onBehalfOfId` porte le
  // titulaire au nom de qui. null dans l'immense majorité des lignes
  // (action normale, jamais en intérim).
  onBehalfOfId String?
  onBehalfOf   User?   @relation("AuditOnBehalfOf", fields: [onBehalfOfId], references: [id])

  createdAt DateTime @default(now())

  // Socle N2 — journal inaltérable (SOC-SEC-04). Colonnes tenues par la base : numéro d'ordre,
  // acteur figé à l'écriture (actorId peut passer à NULL si un compte en attente est supprimé),
  // scellement chaîné (rang, empreinte SHA-256 de la ligne et de la précédente) par audit_sceller().
  // Déclencheurs : aucune modification ni suppression (voir la migration socle_nimba_n2).
  numero              Int     @default(autoincrement())
  acteurInitial       String?
  auNomDeInitial      String?
  rang                Int?
  empreintePrecedente String?
  empreinte           String?

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([onBehalfOfId])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// Module Dossier du personnel — séparation stricte en deux niveaux de
// sensibilité ("besoin d'en connaître", même principe que pour les congés
// maladie — voir CascadeService/LeaveMedicalPrivacyService) :
//
// Niveau 1 (PersonnelFileBasic) : lecture DN/DNA (toute la DNPEC) et Chef de
// Division/Section/Cellule (son périmètre) — même cascade que
// hasDirectAuthorityOver ailleurs dans l'application. Lecture/écriture DRH
// et la personne elle-même.
//
// Niveau 2 (PersonnelFileSensitive, PersonnelDiploma, PersonnelDocument,
// PersonnelCareerEvent) : réservé à la personne elle-même et au DRH.
// PERSONNE d'autre, y compris DN/DNA/Chef de Division — séparation physique
// en tables distinctes plutôt qu'un simple filtre applicatif, pour qu'une
// requête mal écrite sur le niveau 1 ne puisse structurellement pas ramener
// une donnée de niveau 2.
//
// `verifiedFields` (Json, ex. {"grade": true, "echelon": false}) : statut
// "à vérifier" par champ scalaire, quelle que soit la source qui l'a
// renseigné (import Excel, saisie DRH, auto-déclaration) — repassé à false
// dès que le champ est réécrit, remis à true uniquement par l'action
// explicite de l'agent "Confirmer mes informations"
// (PersonnelFilesService.confirmMyInformation). PersonnelDiploma/
// PersonnelDocument portent directement leur propre colonne `verified`
// (déjà une ligne par élément). PersonnelCareerEvent n'a AUCUN statut de
// vérification : journal généré automatiquement (comme AuditLog), jamais
// saisi à la main, rien à confirmer.
// ----------------------------------------------------------------------------

enum EmploymentStatus {
  FONCTIONNAIRE
  CONTRACTUEL
  STAGIAIRE
  MISE_A_DISPOSITION

  @@map("employment_status")
}

enum CareerEventType {
  AFFECTATION // changement de Division/Section/Cellule (voir UsersService.updateAssignment)
  PROMOTION // changement de grade/échelon
  CHANGEMENT_FONCTION // changement de rôle/poste

  @@map("career_event_type")
}

model PersonnelFileBasic {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  employmentStatus       EmploymentStatus?
  grade                  String?
  echelon                String?
  // Socle N6 : catégorie (A, B, C, D…) pour les effectifs ; date du dernier échelon (avancement à instruire).
  categorie              String?
  echelonDepuis          DateTime?         @db.Date
  serviceStartDate       DateTime?
  // Fiche de poste déposée (fichier) — StorageService, même mécanique que la GED.
  jobDescriptionFileKey  String?
  jobDescriptionFileName String?

  verifiedFields Json   @default("{}")
  source         String // 'IMPORT' | 'DRH' | 'SELF' — dernière source d'écriture, informatif

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("personnel_files_basic")
}

model PersonnelFileSensitive {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  personalAddress          String?
  personalPhone            String?
  personalEmail            String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?

  verifiedFields Json   @default("{}")
  source         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("personnel_files_sensitive")
}

model PersonnelDiploma {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("PersonnelDiplomaOwner", fields: [userId], references: [id], onDelete: Cascade)
  title        String
  institution  String?
  obtainedYear Int?
  fileKey      String?
  fileName     String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("personnel_diplomas")
}

model PersonnelDocument {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation("PersonnelDocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  label          String // libre : "CNI", "Acte de naissance", "Casier judiciaire"...
  // Socle N6 : pièce de la liste des pièces requises que ce document fournit (dossier complet).
  pieceRequiseId String?
  pieceRequise   PieceRequise? @relation(fields: [pieceRequiseId], references: [id], onDelete: SetNull)
  fileKey        String
  fileName       String
  uploadedById   String
  uploadedBy     User          @relation("PersonnelDocumentUploadedBy", fields: [uploadedById], references: [id])
  verified       Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@map("personnel_documents")
}

model PersonnelCareerEvent {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation("PersonnelCareerEventSubject", fields: [userId], references: [id], onDelete: Cascade)
  eventType     CareerEventType
  fromValue     String?
  toValue       String?
  effectiveDate DateTime        @default(now())
  recordedById  String
  recordedBy    User            @relation("PersonnelCareerEventRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime        @default(now())

  @@map("personnel_career_events")
}

// ----------------------------------------------------------------------------
// Suppléance / intérim (§4.10) — tout responsable (Chef de Section/Division/
// Cellule, DN/DNA) peut désigner, ou voir désigner par son supérieur direct,
// un suppléant pour une période datée. Pendant cette période, le suppléant
// EMPRUNTE le rôle/rattachement du titulaire (JwtAuthGuard, sur en-tête
// explicite X-Interim-For — jamais ambiant/permanent), ce qui fait
// fonctionner CascadeService sans aucune duplication : autorité
// (hasHierarchicalAuthorityOver) ET visibilité en cascade s'appliquent comme
// si le suppléant était momentanément le titulaire. `id` reste toujours
// celui du suppléant réel — voir AuthenticatedUser.interimForId et
// AuditLog.onBehalfOfId pour la traçabilité "par intérim, au nom de".
//
// Restrictions (décisions de conception validées) : titulaire ET suppléant
// doivent tous deux avoir un rôle "chef" (CHEF_SECTION, CHEF_CELLULE,
// CHEF_DIVISION, DN, DNA) — jamais un AGENT ni un ASSISTANT_DIRECTION, qui
// n'exercent aucune autorité de cascade à emprunter. Une seule suppléance
// active (ou future, non révoquée) à la fois par titulaire — pas de
// chevauchement, jamais deux personnes habilitées à agir en son nom
// simultanément.
model Suppleance {
  id          String   @id @default(cuid())
  titulaireId String
  titulaire   User     @relation("SuppleanceTitulaire", fields: [titulaireId], references: [id])
  suppleantId String
  suppleant   User     @relation("SuppleanceSuppleant", fields: [suppleantId], references: [id])
  startDate   DateTime
  endDate     DateTime

  createdById String // qui a désigné — le titulaire lui-même OU son supérieur direct
  createdBy   User   @relation("SuppleanceCreatedBy", fields: [createdById], references: [id])

  // Fin anticipée (le titulaire revient plus tôt que prévu, erreur de
  // saisie...) — distinct de endDate pour garder l'historique de ce qui
  // était prévu vs. ce qui s'est réellement passé.
  revokedAt   DateTime?
  revokedById String?
  revokedBy   User?     @relation("SuppleanceRevokedBy", fields: [revokedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // D7 — accès délégués à des courriers confidentiels ouverts au suppléant ;
  // ils expirent avec la suppléance (vérifié à chaque lecture).
  accesDelegues AccesDelegueCourrier[]

  @@map("suppleances")
}

// ----------------------------------------------------------------------------
// Module Courrier et actes (D7)
// ----------------------------------------------------------------------------
// Deux flux : le courrier ARRIVÉE (enregistrement → imputation → traitement →
// classement) et les DÉPARTS/ACTES (brouillon → visa → signature numérotée →
// expédition). Voir apps/api/src/courrier/ pour les règles.
//
// Unité (`uniteKey`, jamais nulle) : "DNPEC" pour un registre de portée
// DIRECTION ; "DIV:<divisionId>" ou "CEL:<celluleId>" pour la portée UNITE.
// Clé texte plutôt que deux FK nullables : elle entre dans la clé primaire du
// compteur (PostgreSQL refuse NULL dans une clé primaire).
//
// Intégrité du registre (triggers SQL de la migration add_courrier_actes) :
// une arrivée n'est jamais supprimée, un acte numéroté non plus ; numero,
// sequence, annee, registreId et uniteKey sont figés dès que la séquence est
// attribuée. L'annulation garde le numéro (statut ANNULE + motif).
//
// Besoin d'en connaître (§2.2) : un CONFIDENTIEL n'est jamais lisible par un
// rôle EMPRUNTÉ (intérim) — seulement par identité réelle ou accès délégué
// (AccesDelegueCourrier) ; un PERSONNEL seulement par son destinataire
// (actor.id strict, jamais délégable).

enum RegistreNature {
  ARRIVEE
  DEPART
  ACTE

  @@map("registre_nature")
}

enum RegistrePortee {
  DIRECTION // numérotation unique DNPEC ; départs/actes signés par DN/DNA
  UNITE // numérotation propre à chaque Division/Cellule ; signés par son chef ou DN/DNA

  @@map("registre_portee")
}

enum CourrierConfidentialite {
  ORDINAIRE
  CONFIDENTIEL
  PERSONNEL // pli fermé — arrivées uniquement

  @@map("courrier_confidentialite")
}

enum ArriveeStatut {
  ENREGISTRE
  IMPUTE
  TRAITE
  CLASSE
  ANNULE

  @@map("arrivee_statut")
}

enum ImputationNature {
  ATTRIBUTION
  INFORMATION
  AVIS

  @@map("imputation_nature")
}

enum ImputationStatut {
  EN_COURS
  TRAITEE

  @@map("imputation_statut")
}

enum ActeStatut {
  BROUILLON
  EN_VISA
  RENVOYE
  A_SIGNER
  SIGNE
  EXPEDIE
  ANNULE

  @@map("acte_statut")
}

enum VisaStatut {
  EN_ATTENTE
  VISE
  RENVOYE
  SAUTE // niveau sans objet : rédacteur lui-même chef de ce niveau, ou poste vacant

  @@map("visa_statut")
}

enum PieceCourrierNature {
  SCAN
  ANNEXE
  ACTE_SIGNE

  @@map("piece_courrier_nature")
}

enum AccesDelegueType {
  ASSISTANT
  SUPPLEANT

  @@map("acces_delegue_type")
}

// Registres paramétrables par l'administrateur (comme les types de congés).
// `nature` et `portee` sont figées dès qu'une entrée existe ; changer le
// gabarit ne réécrit jamais un numéro déjà attribué (numero figé).
model RegistreCourrier {
  id            String         @id @default(cuid())
  code          String         @unique
  libelle       String
  nature        RegistreNature
  portee        RegistrePortee
  // Variables : {seq} ou {seq:n} (obligatoire), {code}, {annee}, {unite}.
  gabaritNumero String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  habilitations HabilitationCourrier[]
  compteurs     CompteurRegistre[]
  arrivees      CourrierArrivee[]
  actes         ActeCourrier[]
  famillesRh    FamilleActeRh[]

  @@map("registres_courrier")
}

// Habilitation courrier (secrétariat) : enregistrer les arrivées d'un
// registre pour une unité, expédier ses actes signés. N'est PAS un rôle et ne
// donne AUCUNE autorité d'imputation.
model HabilitationCourrier {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation("HabilitationCourrierUser", fields: [userId], references: [id])
  registreId    String
  registre      RegistreCourrier @relation(fields: [registreId], references: [id])
  uniteKey      String
  accordeeParId String
  accordeePar   User             @relation("HabilitationCourrierAccordeePar", fields: [accordeeParId], references: [id])
  createdAt     DateTime         @default(now())
  revoqueeAt    DateTime?
  revoqueeParId String?
  revoqueePar   User?            @relation("HabilitationCourrierRevoqueePar", fields: [revoqueeParId], references: [id])

  @@index([userId])
  @@map("habilitations_courrier")
}

// Compteur de numérotation : une ligne par (registre, unité, année), incrémentée
// par upsert atomique (INSERT ... ON CONFLICT DO UPDATE ... RETURNING) DANS la
// transaction de l'écriture métier — verrou de ligne, pas de trou (rollback),
// pas de doublon. Voir courrier/numerotation.service.ts.
model CompteurRegistre {
  registreId String
  registre   RegistreCourrier @relation(fields: [registreId], references: [id])
  uniteKey   String
  annee      Int
  dernier    Int
  updatedAt  DateTime         @default(now())

  @@id([registreId, uniteKey, annee])
  @@map("compteurs_registre")
}

model CourrierArrivee {
  id                  String                  @id @default(cuid())
  registreId          String
  registre            RegistreCourrier        @relation(fields: [registreId], references: [id])
  uniteKey            String
  annee               Int
  sequence            Int
  numero              String
  dateReception       DateTime
  expediteur          String
  referenceExpediteur String?
  dateCourrier        DateTime?
  // Dérogation au contrôle des dates (réception dans le futur, ou courrier
  // daté après sa réception) : motif obligatoire, stocké et audité.
  motifDerogationDate String?
  // Toujours null à l'enregistrement d'un PERSONNEL : seul son destinataire
  // peut ensuite compléter la fiche (objet, pièces).
  objet               String?
  confidentialite     CourrierConfidentialite
  destinataireId      String?
  destinataire        User?                   @relation("ArriveeDestinataire", fields: [destinataireId], references: [id])
  statut              ArriveeStatut           @default(ENREGISTRE)
  enregistreParId     String
  enregistrePar       User                    @relation("ArriveeEnregistreePar", fields: [enregistreParId], references: [id])
  classeAt            DateTime?
  classeParId         String?
  classePar           User?                   @relation("ArriveeClasseePar", fields: [classeParId], references: [id])
  annuleAt            DateTime?
  annuleParId         String?
  annulePar           User?                   @relation("ArriveeAnnuleePar", fields: [annuleParId], references: [id])
  motifAnnulation     String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  imputations   ImputationCourrier[]
  pieces        PieceCourrier[]
  accesDelegues AccesDelegueCourrier[]
  actesReponse  ActeCourrier[]

  @@unique([registreId, uniteKey, annee, sequence])
  @@index([annee])
  @@map("courriers_arrivee")
}

model ImputationCourrier {
  id                     String               @id @default(cuid())
  courrierId             String
  courrier               CourrierArrivee      @relation(fields: [courrierId], references: [id])
  parentId               String?
  parent                 ImputationCourrier?  @relation("SousImputations", fields: [parentId], references: [id])
  sousImputations        ImputationCourrier[] @relation("SousImputations")
  imputeParId            String
  imputePar              User                 @relation("ImputationImputePar", fields: [imputeParId], references: [id])
  // Suppléance « P.I. » : titulaire au nom de qui l'imputation a été posée
  // (stocké ici en plus de l'audit).
  auNomDeId              String?
  auNomDe                User?                @relation("ImputationAuNomDe", fields: [auNomDeId], references: [id])
  imputeAId              String
  imputeA                User                 @relation("ImputationImputeA", fields: [imputeAId], references: [id])
  nature                 ImputationNature
  instructions           String?
  echeance               DateTime?
  statut                 ImputationStatut     @default(EN_COURS)
  compteRendu            String?
  reponseActeId          String?
  reponseActe            ActeCourrier?        @relation("ImputationReponse", fields: [reponseActeId], references: [id])
  traiteeAt              DateTime?
  traiteeParId           String?
  traiteePar             User?                @relation("ImputationTraiteePar", fields: [traiteeParId], references: [id])
  // Rappels automatiques (CourrierRappelsService) — posés une seule fois.
  rappelEcheanceEnvoyeAt DateTime?
  rappelRetardEnvoyeAt   DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  tache Task? @relation("ImputationTache")

  @@index([courrierId])
  @@index([imputeAId])
  @@map("imputations_courrier")
}

model ActeCourrier {
  id                       String                  @id @default(cuid())
  registreId               String
  registre                 RegistreCourrier        @relation(fields: [registreId], references: [id])
  // Unité émettrice, figée à la création (rattachement réel du rédacteur).
  uniteKey                 String
  // Numérotation : nulle jusqu'à la SIGNATURE, jamais au brouillon.
  annee                    Int?
  sequence                 Int?
  numero                   String?
  objet                    String
  destinataires            String?
  corps                    String?
  confidentialite          CourrierConfidentialite
  beneficiaireId           String?
  beneficiaire             User?                   @relation("ActeBeneficiaire", fields: [beneficiaireId], references: [id])
  priseConnaissanceRequise Boolean                 @default(false)
  priseConnaissanceAt      DateTime?
  repondAId                String?
  repondA                  CourrierArrivee?        @relation(fields: [repondAId], references: [id])
  redacteurId              String
  redacteur                User                    @relation("ActeRedacteur", fields: [redacteurId], references: [id])
  statut                   ActeStatut              @default(BROUILLON)
  // Nombre de soumissions : 0 = jamais soumis (seul cas de suppression
  // physique possible) ; chaque resoumission recalcule le circuit.
  cycle                    Int                     @default(0)
  motifRenvoi              String?
  signataireId             String?
  signataire               User?                   @relation("ActeSignataire", fields: [signataireId], references: [id])
  signeAuNomDeId           String?
  signeAuNomDe             User?                   @relation("ActeSigneAuNomDe", fields: [signeAuNomDeId], references: [id])
  signeAt                  DateTime?
  expedieAt                DateTime?
  expedieParId             String?
  expediePar               User?                   @relation("ActeExpediePar", fields: [expedieParId], references: [id])
  modeExpedition           String?
  annuleAt                 DateTime?
  annuleParId              String?
  annulePar                User?                   @relation("ActeAnnulePar", fields: [annuleParId], references: [id])
  motifAnnulation          String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  visas              VisaActe[]
  pieces             PieceCourrier[]
  accesDelegues      AccesDelegueCourrier[]
  imputationsReponse ImputationCourrier[]   @relation("ImputationReponse")

  stageAttestation  Stage?
  mouvementCarriere MouvementCarriere?
  // Socle N4 — ordre de mission dont l'acte est la version signée.
  ordreMission      OrdreMission?

  @@unique([registreId, uniteKey, annee, sequence])
  @@index([redacteurId])
  @@map("actes_courrier")
}

// Circuit de visa, recalculé à chaque soumission (cycle) — l'historique des
// cycles précédents est conservé.
model VisaActe {
  id              String       @id @default(cuid())
  acteId          String
  acte            ActeCourrier @relation(fields: [acteId], references: [id], onDelete: Cascade)
  cycle           Int
  ordre           Int
  niveau          SystemRole
  viseurAttenduId String?
  viseurAttendu   User?        @relation("VisaViseurAttendu", fields: [viseurAttenduId], references: [id])
  statut          VisaStatut   @default(EN_ATTENTE)
  motifSaut       String?
  viseParId       String?
  visePar         User?        @relation("VisaVisePar", fields: [viseParId], references: [id])
  viseAuNomDeId   String?
  viseAuNomDe     User?        @relation("VisaViseAuNomDe", fields: [viseAuNomDeId], references: [id])
  commentaire     String?
  viseAt          DateTime?
  createdAt       DateTime     @default(now())

  @@index([acteId, cycle])
  @@map("visas_acte")
}

// Pièce jointe d'une arrivée OU d'un acte (exclusivité vérifiée par
// l'application, comme Task.divisionId/celluleId). Fichier via StorageService.
model PieceCourrier {
  id          String              @id @default(cuid())
  arriveeId   String?
  arrivee     CourrierArrivee?    @relation(fields: [arriveeId], references: [id])
  acteId      String?
  acte        ActeCourrier?       @relation(fields: [acteId], references: [id], onDelete: Cascade)
  nature      PieceCourrierNature
  fileName    String
  fileKey     String
  mimeType    String
  sizeBytes   Int
  deposeParId String
  deposePar   User                @relation(fields: [deposeParId], references: [id])
  createdAt   DateTime            @default(now())

  @@map("pieces_courrier")
}

// Accès délégué à un courrier CONFIDENTIEL (arrivée OU acte), courrier par
// courrier, par quelqu'un qui y a lui-même accès, à SON assistant ou à SON
// suppléant. Révocable, audité ; un accès SUPPLEANT expire avec la suppléance
// (fin, révocation, non-conformité — réévalué à chaque lecture). Jamais pour
// un pli PERSONNEL.
model AccesDelegueCourrier {
  id             String           @id @default(cuid())
  arriveeId      String?
  arrivee        CourrierArrivee? @relation(fields: [arriveeId], references: [id])
  acteId         String?
  acte           ActeCourrier?    @relation(fields: [acteId], references: [id], onDelete: Cascade)
  beneficiaireId String
  beneficiaire   User             @relation("AccesDelegueBeneficiaire", fields: [beneficiaireId], references: [id])
  type           AccesDelegueType
  suppleanceId   String?
  suppleance     Suppleance?      @relation(fields: [suppleanceId], references: [id])
  ouvertParId    String
  ouvertPar      User             @relation("AccesDelegueOuvertPar", fields: [ouvertParId], references: [id])
  createdAt      DateTime         @default(now())
  revoqueAt      DateTime?
  revoqueParId   String?
  revoquePar     User?            @relation("AccesDelegueRevoquePar", fields: [revoqueParId], references: [id])

  @@index([beneficiaireId])
  @@map("acces_delegues_courrier")
}

// ============================================================================
// Rotation des stagiaires (D6, cahier des charges §4.12)
// ============================================================================
// Un stage = une suite de périodes datées dans des unités (Division, Section ou
// Cellule), chacune acceptée par le responsable de l'unité qui désigne le
// tuteur. Le changement d'unité est appliqué par StagesRotationService à la
// date prévue (historique de carrière). Les données personnelles du stagiaire
// restent au niveau 2 du dossier du personnel (D3) : rien n'est dupliqué ici.

enum StageStatut {
  PREVU
  EN_COURS
  TERMINE
  INTERROMPU

  @@map("stage_statut")
}

enum PeriodeStageStatut {
  PROPOSEE // créée par le DRH, en attente du responsable de l'unité
  ACCEPTEE // tuteur désigné
  REFUSEE // motif obligatoire
  EN_COURS // rattachement appliqué
  TERMINEE
  ANNULEE // retirée du plan (jamais supprimée)

  @@map("periode_stage_statut")
}

enum EvaluationFormat {
  GRILLE // 4 critères + appréciation
  TEXTE // appréciation libre
  AUCUNE // pas d'évaluation pour cette période

  @@map("evaluation_format")
}

enum EvaluationStageStatut {
  BROUILLON
  SOUMISE
  RENVOYEE
  VISEE

  @@map("evaluation_stage_statut")
}

model Stage {
  id                  String        @id @default(cuid())
  stagiaireId         String
  stagiaire           User          @relation("StageStagiaire", fields: [stagiaireId], references: [id])
  etablissement       String
  diplomePrepare      String?
  encadrantAcademique String?
  dateDebut           DateTime      @db.Date
  dateFin             DateTime      @db.Date
  statut              StageStatut   @default(PREVU)
  motifInterruption   String?
  clotureAt           DateTime?
  // Attestation finale : acte du module Courrier (registre d'attestations),
  // le stagiaire en est bénéficiaire avec prise de connaissance.
  attestationActeId   String?       @unique
  attestationActe     ActeCourrier? @relation(fields: [attestationActeId], references: [id])
  createdById         String
  createdBy           User          @relation("StageCreePar", fields: [createdById], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  periodes PeriodeStage[]

  // Socle N3 — encadreur principal (SIG-RF-STG-05) et rapport de stage (SIG-RF-STG-11) :
  // déposé par le stagiaire, validé ou renvoyé (motif) par l'encadreur principal, transmis au DRH.
  encadrantPrincipalId String?
  rapportFileKey       String?
  rapportFileName      String?
  rapportDeposeLe      DateTime?
  rapportStatut        String? // DEPOSE | VALIDE | A_REPRENDRE
  rapportMotif         String?
  rapportValideLe      DateTime?
  rapportValideParId   String?

  @@index([stagiaireId])
  @@map("stages")
}

model PeriodeStage {
  id                     String             @id @default(cuid())
  stageId                String
  stage                  Stage              @relation(fields: [stageId], references: [id])
  ordre                  Int
  // Même invariant que User : divisionId (+ sectionId) OU celluleId.
  divisionId             String?
  division               Division?          @relation(fields: [divisionId], references: [id])
  sectionId              String?
  section                Section?           @relation(fields: [sectionId], references: [id])
  celluleId              String?
  cellule                Cellule?           @relation(fields: [celluleId], references: [id])
  dateDebut              DateTime           @db.Date
  dateFin                DateTime           @db.Date
  objectifs              String?
  formatEvaluation       EvaluationFormat
  statut                 PeriodeStageStatut @default(PROPOSEE)
  tuteurId               String?
  tuteur                 User?              @relation("PeriodeTuteur", fields: [tuteurId], references: [id])
  motifRefus             String?
  decideeParId           String?
  decideePar             User?              @relation("PeriodeDecideePar", fields: [decideeParId], references: [id])
  decideeAt              DateTime?
  // Horodatages du job de rotation (chaque action une seule fois).
  rattachementAppliqueAt DateTime?
  rappelAVenirAt         DateTime?
  alerteAt               DateTime?
  rappelEvaluationAt     DateTime?
  relanceEvaluationAt    DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  evaluation EvaluationStage?

  @@index([stageId])
  @@index([divisionId])
  @@index([sectionId])
  @@index([celluleId])
  @@map("periodes_stage")
}

model EvaluationStage {
  id           String                @id @default(cuid())
  periodeId    String                @unique
  periode      PeriodeStage          @relation(fields: [periodeId], references: [id])
  redacteurId  String
  redacteur    User                  @relation("EvaluationRedacteur", fields: [redacteurId], references: [id])
  // Format GRILLE : { assiduite, qualite, autonomie, integration } → niveau.
  criteres     Json?
  appreciation String?
  statut       EvaluationStageStatut @default(BROUILLON)
  motifRenvoi  String?
  soumiseAt    DateTime?
  viseeParId   String?
  viseePar     User?                 @relation("EvaluationViseePar", fields: [viseeParId], references: [id])
  viseeAt      DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@map("evaluations_stage")
}

/// Nombre maximal de stagiaires simultanés d'une unité (« DIV:<id> »,
/// « SEC:<id> », « CEL:<id> »), fixé par le DRH. Sans ligne : pas de limite.
/// Une période en section compte aussi pour sa division.
model CapaciteAccueil {
  uniteKey   String   @id
  maximum    Int
  fixeeParId String?
  fixeePar   User?    @relation("CapaciteFixeePar", fields: [fixeeParId], references: [id])
  updatedAt  DateTime @updatedAt

  @@map("capacites_accueil")
}

enum ModeleAttestationType {
  DOCX // champs {{CLE}} dans le texte
  PDF // formulaire PDF : champs nommés comme les clés

  @@map("modele_attestation_type")
}

/// Modèle d'attestation de stage importé par le DRH. Un seul actif : un nouvel
/// import désactive le précédent (conservé, jamais supprimé).
model ModeleAttestation {
  id           String                @id @default(cuid())
  type         ModeleAttestationType
  fileKey      String
  fileName     String
  champs       Json // clés utilisées par le modèle
  actif        Boolean               @default(true)
  importeParId String?
  importePar   User?                 @relation("ModeleAttestationImportePar", fields: [importeParId], references: [id])
  createdAt    DateTime              @default(now())

  @@map("modeles_attestation")
}

// ============================================================================
// D9 — Logistique : inventaire, demandes, fournitures (cahier §4.13)
// Aucun montant (décision D9-4). Gestionnaire = habilitation, pas un rôle.
// ============================================================================

// Habilitation « gestionnaire logistique », donnée et retirée par
// l'administrateur système, à n'importe quel compte actif (sauf stagiaire).
model HabilitationLogistique {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("HabLogUser", fields: [userId], references: [id])
  accordeeParId String
  accordeePar   User      @relation("HabLogAccordeePar", fields: [accordeeParId], references: [id])
  createdAt     DateTime  @default(now())
  revoqueeAt    DateTime?
  revoqueeParId String?
  revoqueePar   User?     @relation("HabLogRevoqueePar", fields: [revoqueeParId], references: [id])

  @@index([userId])
  @@map("habilitations_logistique")
}

enum NatureCategorieLogistique {
  BIEN // matériel inventorié (numéro d'inventaire)
  FOURNITURE // consommables (articles)

  @@map("nature_categorie_logistique")
}

// Catégorie : porte le réglage « validation du chef requise » des demandes
// (décision D9-2) ; code = préfixe du numéro d'inventaire pour les biens.
model CategorieLogistique {
  id                    String                    @id @default(cuid())
  code                  String                    @unique
  libelle               String
  nature                NatureCategorieLogistique
  validationChefRequise Boolean                   @default(true)
  actif                 Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  biens     Bien[]
  articles  ArticleFourniture[]
  demandes  DemandeLogistique[]
  compteurs CompteurInventaire[]

  @@map("categories_logistique")
}

// Compteur du numéro d'inventaire (catégorie, année) — même mécanisme que
// CompteurRegistre : upsert atomique dans la transaction de création.
model CompteurInventaire {
  categorieId String
  categorie   CategorieLogistique @relation(fields: [categorieId], references: [id])
  annee       Int
  dernier     Int
  updatedAt   DateTime            @default(now())

  @@id([categorieId, annee])
  @@map("compteurs_inventaire")
}

enum EtatBien {
  EN_SERVICE
  EN_PANNE
  EN_REPARATION
  REFORME

  @@map("etat_bien")
}

// Bien inventorié : numéro figé et jamais supprimé (trigger), réformé au lieu
// d'être effacé. Aucune valeur financière.
model Bien {
  id               String              @id @default(cuid())
  numeroInventaire String              @unique
  categorieId      String
  categorie        CategorieLogistique @relation(fields: [categorieId], references: [id])
  annee            Int
  sequence         Int
  designation      String
  marque           String?
  numeroSerie      String?
  emplacement      String?
  dateAcquisition  DateTime?
  etat             EtatBien            @default(EN_SERVICE)
  creeParId        String
  creePar          User                @relation("BienCreePar", fields: [creeParId], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  affectations AffectationBien[]
  mouvements   MouvementBien[]
  demandes     DemandeLogistique[]

  @@unique([categorieId, annee, sequence])
  @@map("biens")
}

// Affectation d'un bien à une personne OU à une unité ; au plus une ouverte
// par bien (index unique partiel, migration). Jamais supprimée.
model AffectationBien {
  id             String    @id @default(cuid())
  bienId         String
  bien           Bien      @relation(fields: [bienId], references: [id])
  userId         String?
  user           User?     @relation("AffectationDetenteur", fields: [userId], references: [id])
  divisionId     String?
  division       Division? @relation("AffectationBienDivision", fields: [divisionId], references: [id])
  sectionId      String?
  section        Section?  @relation("AffectationBienSection", fields: [sectionId], references: [id])
  celluleId      String?
  cellule        Cellule?  @relation("AffectationBienCellule", fields: [celluleId], references: [id])
  debut          DateTime  @default(now())
  fin            DateTime?
  faiteParId     String
  faitePar       User      @relation("AffectationFaitePar", fields: [faiteParId], references: [id])
  // Alerte « bien à récupérer » envoyée (détenteur devenu inactif) — une fois.
  alerteDepartAt DateTime?

  @@index([bienId])
  @@index([userId])
  @@map("affectations_bien")
}

enum TypeMouvementBien {
  ACQUISITION
  AFFECTATION
  RETOUR
  CHANGEMENT_ETAT
  MODIFICATION
  INTERVENTION // demande d'intervention rattachée au bien

  @@map("type_mouvement_bien")
}

// Historique d'un bien : ajout seul (trigger : ni modification ni suppression).
model MouvementBien {
  id        String            @id @default(cuid())
  bienId    String
  bien      Bien              @relation(fields: [bienId], references: [id])
  type      TypeMouvementBien
  detail    Json
  parId     String
  par       User              @relation("MouvementBienPar", fields: [parId], references: [id])
  createdAt DateTime          @default(now())

  @@index([bienId, createdAt])
  @@map("mouvements_bien")
}

// Article de fourniture. suiviStock (décision D9-5) : entrées et sorties
// tenues par le gestionnaire, stock jamais négatif (CHECK en base), alerte
// sous le seuil. Sans suivi : demandes traitées au cas par cas.
model ArticleFourniture {
  id            String              @id @default(cuid())
  categorieId   String
  categorie     CategorieLogistique @relation(fields: [categorieId], references: [id])
  libelle       String
  unite         String              @default("unité")
  suiviStock    Boolean             @default(false)
  stock         Int                 @default(0)
  seuilAlerte   Int?
  // Anti-doublon de l'alerte de stock bas : posé à l'alerte, remis à null
  // quand le stock repasse au niveau du seuil ou au-dessus.
  alerteStockAt DateTime?
  actif         Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  mouvements MouvementStock[]
  demandes   DemandeLogistique[]

  @@map("articles_fourniture")
}

enum TypeMouvementStock {
  ENTREE
  SORTIE

  @@map("type_mouvement_stock")
}

// Journal du stock : ajout seul (trigger).
model MouvementStock {
  id         String             @id @default(cuid())
  articleId  String
  article    ArticleFourniture  @relation(fields: [articleId], references: [id])
  type       TypeMouvementStock
  quantite   Int
  stockApres Int
  motif      String?
  demandeId  String?
  demande    DemandeLogistique? @relation(fields: [demandeId], references: [id])
  parId      String
  par        User               @relation("MouvementStockPar", fields: [parId], references: [id])
  createdAt  DateTime           @default(now())

  @@index([articleId, createdAt])
  @@map("mouvements_stock")
}

enum TypeDemandeLogistique {
  FOURNITURE // article de fourniture + quantité
  MATERIEL // catégorie de biens
  INTERVENTION // panne ou réparation d'un bien

  @@map("type_demande_logistique")
}

enum StatutDemandeLogistique {
  A_VALIDER // attend le chef direct (catégorie avec validation requise)
  A_TRAITER // transmise aux gestionnaires
  EN_TRAITEMENT // prise en charge par un gestionnaire
  TRAITEE
  REFUSEE
  ANNULEE // par le demandeur, avant prise en charge

  @@map("statut_demande_logistique")
}

model DemandeLogistique {
  id              String                  @id @default(cuid())
  demandeurId     String
  demandeur       User                    @relation("DemandeDemandeur", fields: [demandeurId], references: [id])
  type            TypeDemandeLogistique
  categorieId     String
  categorie       CategorieLogistique     @relation(fields: [categorieId], references: [id])
  articleId       String?
  article         ArticleFourniture?      @relation(fields: [articleId], references: [id])
  bienId          String?
  bien            Bien?                   @relation(fields: [bienId], references: [id])
  quantite        Int?
  objet           String
  justification   String?
  // Réglage de la catégorie figé à la soumission (un changement ultérieur ne
  // réécrit pas le circuit d'une demande en cours).
  validationChef  Boolean
  statut          StatutDemandeLogistique
  valideeParId    String?
  valideePar      User?                   @relation("DemandeValideur", fields: [valideeParId], references: [id])
  valideeAt       DateTime?
  traiteeParId    String?
  traiteePar      User?                   @relation("DemandeTraiteePar", fields: [traiteeParId], references: [id])
  priseEnChargeAt DateTime?
  traiteeAt       DateTime?
  quantiteLivree  Int?
  compteRendu     String?
  refuseeParId    String?
  refuseePar      User?                   @relation("DemandeRefuseePar", fields: [refuseeParId], references: [id])
  refuseeAt       DateTime?
  motifRefus      String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  mouvementsStock MouvementStock[]

  @@index([demandeurId])
  @@index([statut])
  @@map("demandes_logistique")
}

// ============================================================================
// D9 — Réservation des salles et du matériel de présentation (cahier §4.13)
// ============================================================================

enum TypeRessource {
  SALLE
  MATERIEL_PRESENTATION

  @@map("type_ressource")
}

enum ModeReservation {
  IMMEDIATE // confirmée d'emblée si le créneau est libre
  VALIDATION // en attente de la validation d'un gestionnaire

  @@map("mode_reservation")
}

model RessourceReservable {
  id          String          @id @default(cuid())
  nom         String          @unique
  type        TypeRessource
  description String?
  capacite    Int?
  mode        ModeReservation @default(IMMEDIATE)
  actif       Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  reservations Reservation[]

  @@map("ressources_reservables")
}

enum StatutReservation {
  EN_ATTENTE // occupe le créneau en attendant le gestionnaire
  CONFIRMEE
  REFUSEE
  ANNULEE
  ANNULEE_PRIORITE // évincée par une personne ayant autorité sur le titulaire

  @@map("statut_reservation")
}

// Pas de chevauchement entre réservations actives (EN_ATTENTE, CONFIRMEE)
// d'une même ressource : trigger qui verrouille la ressource (migration).
model Reservation {
  id              String              @id @default(cuid())
  ressourceId     String
  ressource       RessourceReservable @relation(fields: [ressourceId], references: [id])
  titulaireId     String
  titulaire       User                @relation("ReservationTitulaire", fields: [titulaireId], references: [id])
  // Auteur réel du clic (suppléant en intérim, sinon le titulaire lui-même).
  creeeParId      String
  creeePar        User                @relation("ReservationCreeePar", fields: [creeeParId], references: [id])
  debut           DateTime
  fin             DateTime
  objet           String
  meetingId       String?             @unique
  meeting         Meeting?            @relation(fields: [meetingId], references: [id])
  statut          StatutReservation
  prioritaire     Boolean             @default(false) // prise en faisant valoir la priorité hiérarchique
  decideeParId    String?
  decideePar      User?               @relation("ReservationDecideePar", fields: [decideeParId], references: [id])
  decideeAt       DateTime?
  motifRefus      String?
  annuleeParId    String?
  annuleePar      User?               @relation("ReservationAnnuleePar", fields: [annuleeParId], references: [id])
  annuleeAt       DateTime?
  motifAnnulation String?
  // Éviction : qui a fait valoir sa priorité, et par quelle réservation.
  evinceeParId    String?
  evinceePar      User?               @relation("ReservationPrioritaire", fields: [evinceeParId], references: [id])
  remplaceeParId  String?
  remplaceePar    Reservation?        @relation("ReservationRemplacement", fields: [remplaceeParId], references: [id])
  remplace        Reservation[]       @relation("ReservationRemplacement")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([ressourceId, debut])
  @@index([titulaireId])
  @@map("reservations")
}

// ============================================================================
// Socle NIMBA — lot N1 : organigramme, agents, habilitation à deux axes
// (cahier NIMBA v2.2, Partie 0 §3 à §6). Tout est ADDITIF : les tables
// historiques (divisions, sections, cellules, users.role, habilitations
// courrier et logistique) restent en place et à jour — voir
// docs/conception_N1_socle_NIMBA.md.
// ============================================================================

enum TypeUnite {
  DIRECTION
  DIVISION
  SECTION
  CELLULE
  INSTANCE

  @@map("type_unite")
}

// Unité organisationnelle récursive (§3). En N1, les parentés autorisées sont
// celles que les modules savent exploiter : Direction → Division → Section,
// Direction → Cellule, Direction → Instance ; chaque unité autre que la
// Direction a sa ligne historique (divisionId, sectionId ou celluleId).
model UniteOrganisationnelle {
  id             String                   @id @default(cuid())
  code           String
  libelle        String
  type           TypeUnite
  parentId       String?
  parent         UniteOrganisationnelle?  @relation("UniteParent", fields: [parentId], references: [id])
  enfants        UniteOrganisationnelle[] @relation("UniteParent")
  responsableId  String?
  responsable    User?                    @relation("UniteResponsable", fields: [responsableId], references: [id])
  dateCreation   DateTime                 @default(now())
  dateFermeture  DateTime?
  motifFermeture String?
  fermeeParId    String?
  fermeePar      User?                    @relation("UniteFermeePar", fields: [fermeeParId], references: [id])
  divisionId     String?                  @unique
  division       Division?                @relation(fields: [divisionId], references: [id])
  sectionId      String?                  @unique
  section        Section?                 @relation(fields: [sectionId], references: [id])
  celluleId      String?                  @unique
  cellule        Cellule?                 @relation(fields: [celluleId], references: [id])
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  historique HistoriqueUnite[]
  agents     Agent[]
  objectifs  Objectif[]

  @@unique([parentId, code])
  @@index([parentId])
  @@map("unites_organisationnelles")
}

// Historique d'une unité : une ligne par événement (CREATION, MODIFICATION,
// RESPONSABLE, FERMETURE), valeurs avant/après. auteurId nul = le système.
model HistoriqueUnite {
  id        String                 @id @default(cuid())
  uniteId   String
  unite     UniteOrganisationnelle @relation(fields: [uniteId], references: [id])
  evenement String
  avant     Json?
  apres     Json?
  dateEffet DateTime               @default(now())
  auteurId  String?
  auteur    User?                  @relation("HistoriqueUniteAuteur", fields: [auteurId], references: [id])
  createdAt DateTime               @default(now())

  @@index([uniteId])
  @@map("historique_unites")
}

enum StatutAgent {
  EN_ACTIVITE
  SUSPENDU
  PARTI

  @@map("statut_agent")
}

// Agent (§4, §6) : la personne physique, distincte du compte, qui survit au
// départ. Matricule unique ; « provisoire » tant que le DRH ne l'a pas
// remplacé par le matricule de la Fonction publique.
model Agent {
  id                  String                  @id @default(cuid())
  matricule           String                  @unique
  matriculeProvisoire Boolean                 @default(false)
  nom                 String
  prenoms             String
  genre               String? // 'F' | 'M' — effectifs (N6)
  uniteId             String?
  unite               UniteOrganisationnelle? @relation(fields: [uniteId], references: [id])
  fonction            String?
  statut              StatutAgent             @default(EN_ACTIVITE)
  // Fin prévue (stage ou contrat) : alerte au DRH à J-15 et J-3, passage
  // automatique à « Parti » à l'échéance sauf prolongation.
  dateFinPrevue       DateTime?               @db.Date
  natureFinPrevue     String? // 'STAGE' | 'CONTRAT'
  alerteJ15At         DateTime?
  alerteJ3At          DateTime?
  finConfirmeeAt      DateTime?
  dateDepart          DateTime?
  motifDepart         String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  compte     User?            @relation("AgentCompte")
  mouvements MouvementAgent[]

  @@index([statut])
  @@map("agents")
}

// Cycle de vie daté d'un agent : ENTREE, MUTATION, SUSPENSION, REACTIVATION,
// DEPART, PROLONGATION, FIN_CONFIRMEE, MATRICULE, IDENTITE. auteurId nul = le système.
model MouvementAgent {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  type      String
  avant     Json?
  apres     Json?
  motif     String?
  dateEffet DateTime @default(now())
  auteurId  String?
  auteur    User?    @relation("MouvementAgentAuteur", fields: [auteurId], references: [id])
  createdAt DateTime @default(now())

  @@index([agentId])
  @@map("mouvements_agents")
}

// Axe 2 de l'habilitation (§5.2) : ce que l'agent peut faire. Les trois
// derniers rôles (domaine B) sont prévus sans écran.
enum RoleFonctionnel {
  DRH
  GESTIONNAIRE_RH
  CHEF_SAF
  GESTIONNAIRE_PAIE
  ENCADREUR_STAGE
  AGENT_COURRIER
  ASSISTANT
  VALIDATEUR
  GESTIONNAIRE_LOGISTIQUE
  RESPONSABLE_MODELE
  ANALYSTE
  DECIDEUR

  @@map("role_fonctionnel")
}

// Attribution datée d'un rôle fonctionnel à un compte, cumulable, retirée
// sans jamais être supprimée. AGENT_COURRIER porte sa portée (registre +
// unité) ; les attributions AGENT_COURRIER et GESTIONNAIRE_LOGISTIQUE sont le
// reflet exact des habilitations historiques (liens uniques ci-dessous).
model AttributionRole {
  id                       String          @id @default(cuid())
  userId                   String
  user                     User            @relation("AttributionRoleCompte", fields: [userId], references: [id])
  role                     RoleFonctionnel
  registreId               String?
  uniteKey                 String?
  dateDebut                DateTime        @default(now())
  dateFin                  DateTime?
  motif                    String?
  attribueParId            String?
  attribuePar              User?           @relation("AttributionRoleAttribuePar", fields: [attribueParId], references: [id])
  retireLe                 DateTime?
  retireParId              String?
  retirePar                User?           @relation("AttributionRoleRetirePar", fields: [retireParId], references: [id])
  motifRetrait             String?
  habilitationCourrierId   String?         @unique
  habilitationLogistiqueId String?         @unique
  createdAt                DateTime        @default(now())

  @@index([userId, role])
  @@map("attributions_roles")
}

// Refus d'accès journalisés (§5.5) : tout 403, ancien ou nouveau. Table dédiée
// plutôt qu'une nouvelle valeur du journal d'audit (lu par l'ancien code).
model AccesRefuse {
  id           String   @id @default(cuid())
  userId       String?
  interimForId String?
  methode      String
  route        String
  objetType    String?
  objetId      String?
  etape        String? // PROTEGE | EXTERNE | PERIMETRE | ROLE | AUTRE
  motif        String
  traceId      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@map("acces_refuses")
}

// ----------------------------------------------------------------------------
// Socle NIMBA — lot N2 : connexions, paramètres, tâches planifiées
// ----------------------------------------------------------------------------

/// Journal technique des connexions (SOC-SEC-05) : conservé N mois (paramètre), puis purgé.
/// Pas de clé étrangère : la purge et la suppression d'une inscription restent indépendantes.
model JournalConnexion {
  id         String   @id @default(cuid())
  userId     String?
  email      String
  resultat   String // SUCCES | ECHEC
  motif      String?
  ip         String?
  navigateur String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("journal_connexions")
}

/// Paramètres de fonctionnement (§13.6) : valeur bornée par le serveur, chaque changement audité.
model Parametre {
  cle          String   @id
  valeur       Json
  modifieParId String?
  modifieLe    DateTime @updatedAt

  @@map("parametres")
}

/// Exécutions des tâches planifiées (supervision) : dernière exécution, durée, résultat.
model ExecutionTache {
  id      String    @id @default(cuid())
  tache   String
  debut   DateTime  @default(now())
  fin     DateTime?
  statut  String // EN_COURS | SUCCES | ECHEC
  message String?
  details Json?

  @@index([tache, debut])
  @@map("executions_taches")
}

// ============================================================================
// Socle NIMBA — lot N4 : statut de diffusion, documents générés
// ============================================================================

/// Statut de diffusion commun (§7.1) : décidé par un rôle et journalisé.
enum StatutDiffusion {
  BROUILLON
  VALIDE
  DIFFUSABLE

  @@map("statut_diffusion")
}

/// Typologie documentaire (§8, métadonnées obligatoires).
enum TypeDocument {
  ETUDE
  RAPPORT
  NOTE_TECHNIQUE
  PROCES_VERBAL
  ACTE
  RPEF
  NOTE_CONJONCTURE
  AUTRE

  @@map("type_document")
}

/// Journal des changements de statut de diffusion, pour tout objet (document aujourd'hui,
/// simulation et rapport du domaine B demain). `parId` nul = reprise automatique.
model ChangementStatut {
  id        String           @id @default(cuid())
  objetType String
  objetId   String
  de        StatutDiffusion?
  vers      StatutDiffusion
  motif     String?
  parId     String?
  le        DateTime         @default(now())

  @@index([objetType, objetId])
  @@map("changements_statut")
}

/// Ordre de mission (SIG-RF-DOC) : saisi une fois, puis généré et signé comme un acte.
model OrdreMission {
  id                String           @id @default(cuid())
  agentId           String
  agent             User             @relation("OrdreMissionAgent", fields: [agentId], references: [id])
  objet             String
  destination       String
  dateDepart        DateTime         @db.Date
  dateRetour        DateTime         @db.Date
  transport         String?
  fraisMontant      Int?
  // Socle N6 : véhicule de service affecté par la logistique, kilométrage au départ et au retour.
  vehiculeId        String?
  vehicule          Vehicule?        @relation(fields: [vehiculeId], references: [id])
  kilometrageDepart Int?
  kilometrageRetour Int?
  pleins            PleinCarburant[]
  creeParId         String
  creePar           User             @relation("OrdreMissionCreePar", fields: [creeParId], references: [id])
  acteId            String?          @unique
  acte              ActeCourrier?    @relation(fields: [acteId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([agentId])
  @@map("ordres_mission")
}

/// Éditions d'un document généré signé : la première est l'original, les suivantes des duplicatas.
model DocumentGenere {
  id      String   @id @default(cuid())
  type    String // ATTESTATION_TRAVAIL | ORDRE_MISSION | ATTESTATION_STAGE
  objetId String
  acteId  String?
  edition Int
  format  String // PDF | DOCX
  parId   String
  le      DateTime @default(now())

  @@unique([type, objetId, edition])
  @@map("documents_generes")
}

/// Attestation de travail demandée pour un agent : une par demande, signée comme un acte.
model AttestationTravail {
  id        String   @id @default(cuid())
  agentId   String
  acteId    String?  @unique
  creeParId String
  createdAt DateTime @default(now())

  @@index([agentId])
  @@map("attestations_travail")
}

// ============================================================================
// Socle NIMBA — lot N5 : plan de travail, messagerie en fils, notifications, instructions
// ============================================================================

/// Objectif du plan de travail (SIG-RF-PTA), rattaché à une unité du socle.
model Objectif {
  id          String                 @id @default(cuid())
  annee       Int
  uniteId     String
  unite       UniteOrganisationnelle @relation(fields: [uniteId], references: [id])
  libelle     String
  description String?
  creeParId   String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  activites   Activite[]

  @@index([annee, uniteId])
  @@map("objectifs")
}

/// Activité datée d'un objectif : responsable, indicateur ; avancement calculé depuis ses tâches.
model Activite {
  id            String   @id @default(cuid())
  objectifId    String
  objectif      Objectif @relation(fields: [objectifId], references: [id], onDelete: Cascade)
  libelle       String
  responsableId String
  responsable   User     @relation("ActiviteResponsable", fields: [responsableId], references: [id])
  dateDebut     DateTime @db.Date
  dateFin       DateTime @db.Date
  indicateur    String
  cible         String?
  creeParId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  taches        Task[]

  @@index([objectifId])
  @@index([responsableId])
  @@map("activites")
}

/// Fil de discussion (SIG-RF-MSG) : objet, plusieurs participants, messages successifs.
model FilMessages {
  id               String           @id @default(cuid())
  objet            String
  creeParId        String
  createdAt        DateTime         @default(now())
  dernierMessageLe DateTime         @default(now())
  participants     ParticipantFil[]
  messages         MessageFil[]

  @@index([dernierMessageLe])
  @@map("fils_messages")
}

model ParticipantFil {
  filId    String
  fil      FilMessages @relation(fields: [filId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation("ParticipantFilCompte", fields: [userId], references: [id], onDelete: Cascade)
  ajouteLe DateTime    @default(now())

  @@id([filId, userId])
  @@index([userId])
  @@map("participants_fil")
}

/// Message d'un fil ; la pièce jointe est un renvoi vers un objet de la plateforme (jamais un fichier).
model MessageFil {
  id        String           @id @default(cuid())
  filId     String
  fil       FilMessages      @relation(fields: [filId], references: [id], onDelete: Cascade)
  auteurId  String
  auteur    User             @relation("MessageFilAuteur", fields: [auteurId], references: [id])
  corps     String
  lienType  String? // TACHE | DOCUMENT | REUNION | ARRIVEE | ACTE
  lienId    String?
  createdAt DateTime         @default(now())
  lectures  LectureMessage[]

  @@index([filId, createdAt])
  @@map("messages_fil")
}

/// Accusé de lecture par destinataire.
model LectureMessage {
  messageId String
  message   MessageFil @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  luLe      DateTime   @default(now())

  @@id([messageId, userId])
  @@map("lectures_message")
}

/// Préférences de notification (§9) : résumé quotidien des emails non urgents, heure de Conakry.
model PreferenceNotification {
  userId          String   @id
  user            User     @relation("PreferenceNotificationCompte", fields: [userId], references: [id], onDelete: Cascade)
  resumeQuotidien Boolean  @default(true)
  heureResume     Int      @default(7)
  updatedAt       DateTime @updatedAt

  @@map("preferences_notification")
}

enum StatutInstruction {
  EMISE
  RECUE
  PRISE_EN_COMPTE
  EXECUTEE
  REJETEE

  @@map("statut_instruction")
}

/// Instruction de la Direction (SIG-RF-INS) : émise par le DN ou la DNA, invisible pour l'agent
/// concerné avant son exécution, relancée tous les 7 jours tant qu'elle n'est pas close.
model Instruction {
  id              String            @id @default(cuid())
  objet           String
  texte           String
  emetteurId      String
  emetteur        User              @relation("InstructionEmetteur", fields: [emetteurId], references: [id])
  destinataireId  String
  destinataire    User              @relation("InstructionDestinataire", fields: [destinataireId], references: [id])
  agentConcerneId String?
  agentConcerne   User?             @relation("InstructionAgentConcerne", fields: [agentConcerneId], references: [id])
  echeance        DateTime?         @db.Date
  statut          StatutInstruction @default(EMISE)
  emiseLe         DateTime          @default(now())
  recueLe         DateTime?
  priseEnCompteLe DateTime?
  executeeLe      DateTime?
  rejeteeLe       DateTime?
  motifRejet      String?
  compteRendu     String?
  acteId          String?
  relanceLe       DateTime?

  @@index([destinataireId, statut])
  @@index([emetteurId])
  @@map("instructions")
}

// ---------------------------------------------------------------------------
// Socle NIMBA, lot N6 — effectifs et alertes RH, carrière et actes, fiches de poste, formation,
// véhicules de service et carburant (cahier NIMBA A3.5, A3.6, A5 logistique, SIG-RF-CAR, SIG-RF-LOG-03).

/// Pièce exigée pour un dossier complet (liste tenue par le DRH à l'écran).
model PieceRequise {
  id        String   @id @default(cuid())
  libelle   String   @unique
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  documents PersonnelDocument[]

  @@map("pieces_requises")
}

enum TypeMouvementCarriere {
  NOMINATION
  AVANCEMENT_ECHELON
  PROMOTION
  MUTATION
  FIN_CONTRAT

  @@map("type_mouvement_carriere")
}

enum StatutMouvementCarriere {
  PREPARE
  EN_ACTE
  APPLIQUE
  ANNULE

  @@map("statut_mouvement_carriere")
}

/// Famille d'actes des RH : sa séquence est celle de son registre du Courrier (numérotation continue,
/// jamais réutilisée), son signataire celui du registre (portée Direction : DN ou DNA).
model FamilleActeRh {
  code       String            @id
  libelle    String
  registreId String?
  registre   RegistreCourrier? @relation(fields: [registreId], references: [id])
  updatedAt  DateTime          @updatedAt

  @@map("familles_actes_rh")
}

/// Mouvement de carrière daté : préparé par le DRH, porté par un acte du Courrier, appliqué au dossier
/// à la signature de l'acte.
model MouvementCarriere {
  id          String                  @id @default(cuid())
  userId      String
  type        TypeMouvementCarriere
  avant       Json
  apres       Json
  dateEffet   DateTime                @db.Date
  motif       String?
  statut      StatutMouvementCarriere @default(PREPARE)
  familleCode String
  acteId      String?                 @unique
  acte        ActeCourrier?           @relation(fields: [acteId], references: [id])
  creeParId   String
  appliqueLe  DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  changementRole ChangementRoleNomination?

  @@index([userId])
  @@map("mouvements_carriere")
}

/// Nomination à un poste de responsabilité (chef d'unité, DN, DNA) : à la signature de l'acte, un
/// changement de rôle pré-rempli attend la décision de l'administrateur système, qui le confirme
/// (rôle et unité appliqués par le changement de rôle, ancien titulaire compris) ou le refuse (motif).
enum StatutChangementRole {
  EN_ATTENTE
  APPLIQUE
  REFUSE

  @@map("statut_changement_role")
}

model ChangementRoleNomination {
  id                  String               @id @default(cuid())
  mouvementId         String               @unique
  mouvement           MouvementCarriere    @relation(fields: [mouvementId], references: [id])
  userId              String
  acteNumero          String
  roleCible           SystemRole
  divisionId          String?
  sectionId           String?
  celluleId           String?
  /// Titulaire du poste à la signature (null : poste vacant) et rôle proposé pour lui (null : à choisir).
  ancienTitulaireId   String?
  roleAncienTitulaire SystemRole?
  statut              StatutChangementRole @default(EN_ATTENTE)
  motifRefus          String?
  /// Dernier refus du changement de rôle lors d'une confirmation (le changement reste en attente).
  erreur              String?
  decideParId         String?
  decideLe            DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([statut])
  @@map("changements_role_nomination")
}

/// Fiche de poste rattachée à la fonction, non à la personne.
model FichePoste {
  id          String   @id @default(cuid())
  fonction    String   @unique
  missions    String
  activites   String?
  competences String?
  majParId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("fiches_poste")
}

/// Besoin de formation exprimé par une unité, consolidé par le DRH dans le plan annuel.
model BesoinFormation {
  id        String   @id @default(cuid())
  annee     Int
  uniteId   String
  intitule  String
  priorite  String // HAUTE | MOYENNE | BASSE
  origine   String // ENTRETIEN | PLAN_TRAVAIL | NOUVELLE_FONCTION | REGLEMENTAIRE | AUTRE
  effectif  Int      @default(1)
  statut    String   @default("EXPRIME") // EXPRIME | RETENU | REALISE | ECARTE
  creeParId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([annee])
  @@map("besoins_formation")
}

/// Véhicule de service (logistique) : affecté aux ordres de mission, suivi du kilométrage et du carburant.
model Vehicule {
  id              String   @id @default(cuid())
  immatriculation String   @unique
  marque          String
  modele          String
  energie         String // ESSENCE | GAZOLE
  kilometrage     Int      @default(0)
  etat            EtatBien @default(EN_SERVICE)
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  missions OrdreMission[]
  pleins   PleinCarburant[]

  @@map("vehicules")
}

model PleinCarburant {
  id             String        @id @default(cuid())
  vehiculeId     String
  vehicule       Vehicule      @relation(fields: [vehiculeId], references: [id])
  date           DateTime      @db.Date
  litres         Decimal       @db.Decimal(8, 2)
  kilometrage    Int
  ordreMissionId String?
  ordreMission   OrdreMission? @relation(fields: [ordreMissionId], references: [id], onDelete: SetNull)
  saisiParId     String
  createdAt      DateTime      @default(now())

  @@index([vehiculeId, date])
  @@map("pleins_carburant")
}

// ---------------------------------------------------------------------------------------------
// Domaine B, lot B1 — référentiel des modèles et dépôt par paquet (format « dnpec-modele/1 »).
// Tables nouvelles pointant vers les anciennes (comptes par identifiant), jamais l'inverse.
// Retour arrière : prisma/retour-arriere/b1_down.sql.
// ---------------------------------------------------------------------------------------------

enum StatutVersionModele {
  DEPOSEE // paquet reçu, vérification automatique en attente ou en cours
  CONTROLEE // contrôles de dépôt faits : l'administrateur règle les manettes
  EN_ATTENTE // envoyée au responsable du modèle (approbation)
  ACTIVE // seule version qui fait foi (une par modèle)
  REFUSEE // refusée par le responsable (motif)
  ARCHIVEE // ancienne version active, remplacée ; reste consultable

  @@map("statut_version_modele")
}

enum RoleModelisation {
  ANALYSTE // attribué par l'administrateur, sans modèle
  RESPONSABLE // d'un modèle, désigné par l'administrateur, le DN ou la DNA
  SUPPLEANT // du responsable d'un modèle

  @@map("role_modelisation")
}

enum TypeTravailCalcul {
  VERIFICATION
  EXECUTION

  @@map("type_travail_calcul")
}

enum StatutTravailCalcul {
  EN_FILE
  EN_COURS
  TERMINE
  ECHEC

  @@map("statut_travail_calcul")
}

/// Modèle du référentiel ; créé au dépôt de sa première version (code lu dans modele.json).
model Modele {
  id             String   @id @default(cuid())
  code           String   @unique
  nom            String
  famille        String
  familleLibelle String?
  description    String?
  creeParId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions     VersionModele[]
  affectations AffectationModelisation[]

  @@map("modeles")
}

/// Version déposée d'un modèle : paquet immuable (empreinte SHA-256, déclencheur en base).
model VersionModele {
  id                String              @id @default(cuid())
  modeleId          String
  modele            Modele              @relation(fields: [modeleId], references: [id])
  numero            Int
  empreinte         String
  fileKey           String
  nomFichier        String
  tailleOctets      Int
  /// modele.json validé au dépôt (format dnpec-modele/1).
  fiche             Json
  statut            StatutVersionModele @default(DEPOSEE)
  /// Contrôles de dépôt renvoyés par le service de calcul (valeurs techniques).
  controles         Json?
  controleLe        DateTime?
  /// Réglage des manettes par l'administrateur (étape 3) : [{ id, actif, min, max }] — jamais dans le zip.
  manettes          Json
  /// Compteurs proposés aux analystes : [{ id, actif }].
  compteurs         Json
  /// Dérogations sur des contrôles bloquants en échec : demandées par le responsable, confirmées par l'administrateur.
  derogations       Json                @default("[]")
  avecDerogation    Boolean             @default(false)
  /// Case « Je confirme que les données de ce paquet sont publiées ou autorisées pour cet hébergement ».
  donneesConfirmees Boolean
  auteurId          String
  envoyeParId       String?
  envoyeLe          DateTime?
  approbateurId     String?
  approuveLe        DateTime?
  refuseParId       String?
  refuseLe          DateTime?
  motifRefus        String?
  activeLe          DateTime?
  archiveLe         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  travaux TravailCalcul[]

  @@unique([modeleId, numero])
  @@unique([modeleId, empreinte])
  @@index([statut])
  @@map("versions_modele")
}

/// Rôle de modélisation (le rang ne donne aucun droit) : analyste, responsable ou suppléant d'un modèle.
/// Personnel : jamais emprunté en intérim. Historique conservé (fin datée, motivée).
model AffectationModelisation {
  id            String           @id @default(cuid())
  userId        String
  role          RoleModelisation
  modeleId      String?
  modele        Modele?          @relation(fields: [modeleId], references: [id])
  attribueParId String
  motif         String
  debut         DateTime         @default(now())
  fin           DateTime?
  finParId      String?
  motifFin      String?

  @@index([userId])
  @@index([modeleId])
  @@map("affectations_modelisation")
}

/// File de travaux du service de calcul (vérification d'un paquet, exécution d'un scénario).
/// Reprise si le service dort ou ne répond pas : nouvel essai à prochaineTentativeLe.
model TravailCalcul {
  id                   String              @id @default(cuid())
  type                 TypeTravailCalcul
  statut               StatutTravailCalcul @default(EN_FILE)
  /// Étape affichée : REVEIL (« Réveil du service de calcul… ») puis CALCUL (« Calcul en cours… »).
  etape                String?
  versionId            String
  version              VersionModele       @relation(fields: [versionId], references: [id])
  demandeurId          String
  scenario             Json?
  /// Résultat d'une exécution (chiffres économiques) : lu par le demandeur seul, jamais par l'administrateur.
  resultat             Json?
  message              String?
  tentatives           Int                 @default(0)
  prochaineTentativeLe DateTime            @default(now())
  enFileLe             DateTime            @default(now())
  debuteLe             DateTime?
  termineLe            DateTime?
  dureeMs              Int?

  @@index([statut, prochaineTentativeLe])
  @@index([versionId])
  @@map("travaux_calcul")
}
